# 2026-08-16
#
# PLAN-IVMT -- the campaign spec, committed RED on purpose.  Sections
# map to phases: 1 = P1 (mviews over temporal bases), 2-3 = P2
# (TEMPORAL MATERIALIZED VIEW + the rollup replay proof), 4-6 = P4
# (DISTINCT single/join, HAVING), 7 = refusals by name, 8 = DROP
# discipline.  P3's replication pin lives beside repl2.test, not here.
#
# THE RULE (PLAN-IVMT): if an expectation below is wrong, the plan and
# design doc change FIRST -- the spec is not edited to make red go
# green.
#
set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix ivmt1

#--- 1: a materialized view over a TEMPORAL base (Q1: refusal lifted)
do_execsql_test 1.0 {
  CREATE TEMPORAL TABLE tt(a INTEGER PRIMARY KEY, g INTEGER, x INTEGER)
    WITH SYSTEM VERSIONING;
  CREATE MATERIALIZED VIEW mv AS
    SELECT g, count(*) AS n, sum(x) AS s FROM tt GROUP BY g;
  SELECT count(*) FROM mv;
} {0}
do_execsql_test 1.1 {
  INSERT INTO tt VALUES(1, 7, 100);
  INSERT INTO tt VALUES(2, 7, 50);
  INSERT INTO tt VALUES(3, 8, 10);
  UPDATE tt SET x=60 WHERE a=2;
  DELETE FROM tt WHERE a=3;
  SELECT g, n, s FROM mv ORDER BY g;
} {7 2 160}
do_execsql_test 1.2 {
  SELECT detail FROM pragma_view_check('mv') WHERE kind='summary';
} {{1 groups compared, 0 differ}}
# REPLACE displacement with BOTH machineries listening (the 2026-08-16
# displacement fix, composed)
do_execsql_test 1.3 {
  PRAGMA recursive_triggers=OFF;
  REPLACE INTO tt VALUES(1, 9, 5);
  SELECT g, n, s FROM mv ORDER BY g;
} {7 1 60 9 1 5}
do_execsql_test 1.4 {
  SELECT count(*) FROM sqlite_hist_tt WHERE a=1 AND seq_to IS NULL;
} {1}
# base history stays queryable THROUGH the composition
do_execsql_test 1.5 {
  SELECT g FROM tt FOR SYSTEM_TIME AS OF 3 ORDER BY a;
} {7 7 8}

#--- 2: CREATE TEMPORAL MATERIALIZED VIEW (Q2, eager-only)
reset_db
do_execsql_test 2.0 {
  CREATE TABLE ev(id INTEGER PRIMARY KEY, g INTEGER, x INTEGER);
  CREATE TEMPORAL MATERIALIZED VIEW tmv
    WITH SYSTEM VERSIONING AS
    SELECT g, count(*) AS n, sum(x) AS s FROM ev GROUP BY g;
  SELECT name FROM sqlite_schema WHERE name LIKE '%tmv%' ORDER BY name;
} {sqlite_autoindex_sqlite_hist_tmv_1 sqlite_autoindex_tmv_1
   sqlite_hist_tmv tmv}
# one commit stamps base-cause and rollup-effect with the SAME seq
do_execsql_test 2.1 {
  INSERT INTO ev VALUES(1, 5, 10);
  INSERT INTO ev VALUES(2, 5, 20);
  SELECT g, n, s, seq_from, coalesce(seq_to,'open')
    FROM sqlite_hist_tmv ORDER BY seq_from, g;
} {5 1 10 1 2 5 2 30 2 open}
# AS OF on the VIEW: what did the rollup say at commit 1?
do_execsql_test 2.2 {
  SELECT g, n, s FROM tmv FOR SYSTEM_TIME AS OF 1;
} {5 1 10}
do_execsql_test 2.3 {
  SELECT g, n, s FROM tmv ORDER BY g;
} {5 2 30}
# a group's death is a closed interval, not an erasure
do_execsql_test 2.4 {
  DELETE FROM ev WHERE g=5;
  SELECT count(*) FROM tmv;
} {0}
do_execsql_test 2.5 {
  SELECT g, n, s FROM tmv FOR SYSTEM_TIME AS OF 2;
} {5 2 30}
# global aggregate: single-row rollup, history still exact
do_execsql_test 2.6 {
  CREATE TEMPORAL MATERIALIZED VIEW gtot
    WITH SYSTEM VERSIONING AS
    SELECT count(*) AS n FROM ev;
  INSERT INTO ev VALUES(10, 1, 1);
  INSERT INTO ev VALUES(11, 1, 1);
  SELECT n FROM gtot;
} {2}
do_execsql_test 2.7 {
  SELECT n FROM gtot FOR SYSTEM_TIME AS OF
    (SELECT max(seq)-1 FROM sqlite_hist_commits);
} {1}

#--- 3: the rollup replay proof (temporal2's shape aimed at the view)
reset_db
set WORKLOAD {
  {{INSERT INTO ev VALUES(1,1,10)}}
  {{INSERT INTO ev VALUES(2,1,20)} {INSERT INTO ev VALUES(3,2,5)}}
  {{UPDATE ev SET x=25 WHERE id=2}}
  {{DELETE FROM ev WHERE id=1}}
  {{UPDATE ev SET g=2 WHERE id=2} {INSERT INTO ev VALUES(4,1,7)}}
}
do_test 3.0 {
  execsql {
    CREATE TABLE ev(id INTEGER PRIMARY KEY, g INTEGER, x INTEGER);
    CREATE TEMPORAL MATERIALIZED VIEW tmv
      WITH SYSTEM VERSIONING AS
      SELECT g, count(*) AS n, sum(x) AS s FROM ev GROUP BY g;
  }
  foreach txn $::WORKLOAD {
    db eval BEGIN
    foreach stmt $txn { db eval $stmt }
    db eval COMMIT
  }
  db eval {SELECT max(seq) FROM sqlite_hist_commits}
} [llength $WORKLOAD]
proc rollup_replay {k} {
  forcedelete ivmt_replay.db
  sqlite3 dbr ivmt_replay.db
  dbr eval {CREATE TABLE ev(id INTEGER PRIMARY KEY, g INTEGER, x INTEGER)}
  for {set j 0} {$j < $k} {incr j} {
    dbr eval BEGIN
    foreach stmt [lindex $::WORKLOAD $j] { dbr eval $stmt }
    dbr eval COMMIT
  }
  set r [dbr eval {SELECT g, count(*), sum(x) FROM ev GROUP BY g ORDER BY g}]
  dbr close
  forcedelete ivmt_replay.db
  return $r
}
proc rollup_asof {k} {
  db eval "SELECT g, n, s FROM tmv FOR SYSTEM_TIME AS OF $k ORDER BY g"
}
do_test 3.1 {
  set nBad 0
  for {set k 1} {$k <= [llength $::WORKLOAD]} {incr k} {
    if {[rollup_replay $k] ne [rollup_asof $k]} { incr nBad }
  }
  set nBad
} {0}
# CONTROL, kept forever: corrupt one closed rollup interval; the proof
# must go red, then recover.
do_test 3.2 {
  db eval {PRAGMA writable_schema=ON}
  db eval {UPDATE sqlite_hist_tmv SET s=99999
            WHERE seq_to IS NOT NULL AND g=1 AND n=2}
  db eval {PRAGMA writable_schema=OFF}
  set caught 0
  for {set k 1} {$k <= [llength $::WORKLOAD]} {incr k} {
    if {[rollup_replay $k] ne [rollup_asof $k]} { set caught 1 }
  }
  set caught
} {1}
do_test 3.3 {
  db eval {PRAGMA writable_schema=ON}
  db eval {UPDATE sqlite_hist_tmv SET s=45 WHERE s=99999}
  db eval {PRAGMA writable_schema=OFF}
  set nBad 0
  for {set k 1} {$k <= [llength $::WORKLOAD]} {incr k} {
    if {[rollup_replay $k] ne [rollup_asof $k]} { incr nBad }
  }
  set nBad
} {0}

#--- 4: COUNT(DISTINCT x), single table (Q5)
reset_db
do_execsql_test 4.0 {
  CREATE TABLE t(id INTEGER PRIMARY KEY, g INTEGER, v INTEGER);
  CREATE MATERIALIZED VIEW dm AS
    SELECT g, count(DISTINCT v) AS dv, count(*) AS n FROM t GROUP BY g;
  INSERT INTO t VALUES(1, 1, 100);
  INSERT INTO t VALUES(2, 1, 100);
  INSERT INTO t VALUES(3, 1, 200);
  INSERT INTO t VALUES(4, 2, 100);
  SELECT g, dv, n FROM dm ORDER BY g;
} {1 2 3 2 1 1}
do_execsql_test 4.1 {
  DELETE FROM t WHERE id=2;
  SELECT g, dv, n FROM dm ORDER BY g;
} {1 2 2 2 1 1}
do_execsql_test 4.2 {
  DELETE FROM t WHERE id=1;
  SELECT g, dv, n FROM dm ORDER BY g;
} {1 1 1 2 1 1}
do_execsql_test 4.3 {
  UPDATE t SET v=NULL WHERE id=3;
  SELECT g, dv, n FROM dm ORDER BY g;
} {1 0 1 2 1 1}
do_execsql_test 4.4 {
  SELECT detail FROM pragma_view_check('dm') WHERE kind='summary';
} {{2 groups compared, 0 differ}}

#--- 5: COUNT(DISTINCT root) over a multiplying join (Sean's shape)
reset_db
do_execsql_test 5.0 {
  CREATE TABLE o(id INTEGER PRIMARY KEY, cust INTEGER);
  CREATE TABLE i(id INTEGER PRIMARY KEY, oid INTEGER, sku INTEGER);
  CREATE MATERIALIZED VIEW dj AS
    SELECT count(DISTINCT o.cust) AS nc, count(*) AS n
    FROM o JOIN i ON i.oid = o.id;
  INSERT INTO o VALUES(1, 77);
  INSERT INTO o VALUES(2, 77);
  INSERT INTO o VALUES(3, 88);
  INSERT INTO i(oid, sku) VALUES(1, 1), (1, 2), (2, 9), (3, 4);
  SELECT nc, n FROM dj;
} {2 4}
# the value survives one parent's death via the other
do_execsql_test 5.1 {
  DELETE FROM o WHERE id=1;
  SELECT nc, n FROM dj;
} {2 2}
# child rebind moves a reference between values
do_execsql_test 5.2 {
  UPDATE i SET oid=3 WHERE oid=2;
  SELECT nc, n FROM dj;
} {1 2}
# counted-value change under live join rows
do_execsql_test 5.3 {
  UPDATE o SET cust=99 WHERE id=3;
  SELECT nc, n FROM dj;
} {1 2}
do_execsql_test 5.4 {
  SELECT detail FROM pragma_view_check('dj') WHERE kind='summary';
} {{1 groups compared, 0 differ}}

#--- 6: HAVING over fully-tracked groups
reset_db
do_execsql_test 6.0 {
  CREATE TABLE t(id INTEGER PRIMARY KEY, g INTEGER, x INTEGER);
  CREATE MATERIALIZED VIEW hv AS
    SELECT g, count(*) AS n FROM t GROUP BY g HAVING count(*) >= 2;
  INSERT INTO t VALUES(1, 1, 0);
  SELECT count(*) FROM hv;
} {0}
do_execsql_test 6.1 {
  INSERT INTO t VALUES(2, 1, 0);
  SELECT g, n FROM hv;
} {1 2}
# a group can LEAVE and COME BACK -- the tracking never forgot it
do_execsql_test 6.2 {
  DELETE FROM t WHERE id=2;
  SELECT count(*) FROM hv;
} {0}
do_execsql_test 6.3 {
  INSERT INTO t VALUES(3, 1, 0);
  SELECT g, n FROM hv;
} {1 2}
do_execsql_test 6.4 {
  SELECT detail FROM pragma_view_check('hv') WHERE kind='summary';
} {{1 groups compared, 0 differ}}

#--- 7: refusals, each by name
do_catchsql_test 7.0 {
  CREATE MATERIALIZED VIEW bad1 AS SELECT sum(DISTINCT x) AS s FROM t;
} {1 {bad1 cannot be incrementally maintained: SUM(DISTINCT) is not maintainable (COUNT(DISTINCT) only in v1)}}
do_catchsql_test 7.1 {
  CREATE MATERIALIZED VIEW bad2 AS SELECT avg(DISTINCT x) AS s FROM t;
} {1 {bad2 cannot be incrementally maintained: AVG(DISTINCT) is not maintainable (COUNT(DISTINCT) only in v1)}}
do_catchsql_test 7.2 {
  CREATE TEMPORAL MATERIALIZED VIEW bad3
    WITH SYSTEM VERSIONING WITH MAINTENANCE DEFERRED AS
    SELECT count(*) AS n FROM t;
} {1 {a TEMPORAL materialized view must be EAGER: deferred maintenance would version fold-times, not commit-times}}
do_catchsql_test 7.3 {
  CREATE TEMPORAL MATERIALIZED VIEW bad4 AS SELECT count(*) AS n FROM t;
} {1 {CREATE TEMPORAL MATERIALIZED VIEW requires WITH SYSTEM VERSIONING}}

#--- 8: DROP discipline for the temporal mview
reset_db
do_execsql_test 8.0 {
  CREATE TABLE ev(id INTEGER PRIMARY KEY, g INTEGER);
  CREATE TEMPORAL MATERIALIZED VIEW tmv
    WITH SYSTEM VERSIONING AS
    SELECT g, count(*) AS n FROM ev GROUP BY g;
  INSERT INTO ev VALUES(1, 1);
  DROP MATERIALIZED VIEW tmv;
  SELECT count(*) FROM sqlite_schema WHERE name LIKE '%tmv%';
} {0}

finish_test
