# 2026-08-06
#
# Sanity checks standing behind DOCKET 3h (interleaved segments), taken BEFORE
# the merge driver is written rather than after.
#
# Two questions were recorded there as reasoned-from-source but NOT measured:
#
#   Risk 2. Is sqlite3VdbeApplyProcSet safe to apply repeatedly mid-statement?
#           Its column-name array is deliberately sized for the WIDEST set so
#           advancing never reallocates -- but "written for mid-statement
#           change" is not "written for per-row change", and interleaving would
#           call it per row.
#
#   Risk 3. What does a client see at an index the CURRENT segment does not
#           have?  columnMem() returns columnNullValue() with SQLITE_RANGE, so
#           the answer is NULL -- not a crash, and not stale data from the wider
#           segment.  That silent failure mode is the reason interleaving must
#           be opt-in, so it is pinned here as a test rather than left as a
#           reading of the source.
#
# The shape gives three segments whose widths NARROW then WIDEN (4, 2, 3), so
# the widest-set array is exercised in both directions.

set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix procinter

do_execsql_test 0.0 {
  CREATE TABLE posts(id INTEGER PRIMARY KEY, title TEXT);
  CREATE TABLE comments(post_id INTEGER, cid INTEGER);
  CREATE TABLE tags(post_id INTEGER, tag TEXT, weight INTEGER);
  INSERT INTO posts VALUES(1,'first'),(2,'second');
  INSERT INTO comments VALUES(1,10),(1,11),(2,12);
  INSERT INTO tags VALUES(1,'sql',5),(2,'zig',7);

  CREATE PROCEDURE atlas()
  RETURNS TABLE(id INTEGER, title TEXT,
                comments TABLE(post_id INTEGER, cid INTEGER) KEY(post_id = id),
                tags TABLE(post_id INTEGER, tag TEXT, weight INTEGER)
                     KEY(post_id = id))
  BEGIN
    SELECT id, title FROM posts;
    SELECT post_id, cid FROM comments;
    SELECT post_id, tag, weight FROM tags;
  END;
} {}

# Magnitudes stated before anything is compared, so a wrong number is visible
# as wrong rather than merely unfamiliar.
do_execsql_test 0.1 {
  SELECT (SELECT count(*) FROM posts),
         (SELECT count(*) FROM comments),
         (SELECT count(*) FROM tags);
} {2 3 2}

# Walk every segment, recording arity and names as we go.  Returns a list of
# {width name name ...} per segment.
proc walk {sql} {
  set S [sqlite3_prepare_v2 db $sql -1 TAIL]
  set out {}
  while {1} {
    set seg [list [sqlite3_column_count $S]]
    for {set i 0} {$i < [sqlite3_column_count $S]} {incr i} {
      lappend seg [sqlite3_column_name $S $i]
    }
    lappend out $seg
    while {[sqlite3_step $S] eq "SQLITE_ROW"} {}
    if {[sqlite3_proc_next_resultset $S] ne "SQLITE_OK"} break
  }
  sqlite3_finalize $S
  return $out
}

#--------------------------------------------------------------------
# 1.x: risk 2 -- repeated ApplyProcSet across narrowing and widening
#
do_test 1.0 {
  set r {}
  foreach seg [walk {CALL atlas()}] { lappend r [lindex $seg 0] }
  set r
} {4 2 3}

do_test 1.1 {
  walk {CALL atlas()}
} {{4 id title comments tags} {2 post_id cid} {3 post_id tag weight}}

# The metadata must survive being applied repeatedly, not merely once: walking
# the same statement shape twice must give byte-identical answers.  A stale
# pointer or a reused buffer would show up here as drift on the second pass.
do_test 1.2 {
  expr {[walk {CALL atlas()}] eq [walk {CALL atlas()}]}
} {1}

#--------------------------------------------------------------------
# 2.x: risk 3 -- what an out-of-range index yields on a NARROWER segment
#
# Segment 1 (comments) has 2 columns.  Index 3 is valid on segment 0 and not
# here.  The value must be NULL/empty -- NOT the segment-0 value that occupied
# that register, which is the failure a client would misread as data.
#
do_test 2.0 {
  set S [sqlite3_prepare_v2 db {CALL atlas()} -1 TAIL]
  # drain segment 0 (width 4), then advance to segment 1 (width 2)
  while {[sqlite3_step $S] eq "SQLITE_ROW"} {}
  sqlite3_proc_next_resultset $S
  sqlite3_step $S
  # NB: every read must happen BEFORE finalize.  An earlier draft of this test
  # asked for the width after finalizing and got 4 -- the PREVIOUS segment's
  # width, read out of freed memory.  Not a crash, and a number plausible
  # enough to look like a real answer.
  set width [sqlite3_column_count $S]
  set inrange [sqlite3_column_text $S 0]
  set outrange [sqlite3_column_text $S 3]
  sqlite3_finalize $S
  list $width $inrange $outrange
} {2 1 {}}

# POSITIVE CONTROL for 2.0.  If sqlite3_column_text returned "" for every index
# -- a broken accessor, or a statement that never produced a row -- then 2.0
# would pass while proving nothing.  This asserts the same accessor DOES return
# a non-empty value at an index the segment has, on the same row.
do_test 2.1 {
  set S [sqlite3_prepare_v2 db {CALL atlas()} -1 TAIL]
  while {[sqlite3_step $S] eq "SQLITE_ROW"} {}
  sqlite3_proc_next_resultset $S
  sqlite3_step $S
  set c0 [sqlite3_column_text $S 0]
  set c1 [sqlite3_column_text $S 1]
  sqlite3_finalize $S
  list [expr {$c0 ne ""}] [expr {$c1 ne ""}]
} {1 1}

#--------------------------------------------------------------------
# 3.x: sqlite3_proc_current_segment() -- the discriminator (DOCKET 3h)
#
# Inferring the segment from sqlite3_column_count() does not work and fails
# SILENTLY: two segments may be equally wide, and 2.0 above shows that reading
# a column the segment lacks yields NULL rather than an error.  This accessor
# is the only reliable answer, and it is correct in the segmented protocol
# today -- it does not wait on the merge driver.
#
do_test 3.0 {
  set S [sqlite3_prepare_v2 db {CALL atlas()} -1 TAIL]
  set r {}
  while {1} {
    lappend r [sqlite3_proc_current_segment $S]
    while {[sqlite3_step $S] eq "SQLITE_ROW"} {}
    if {[sqlite3_proc_next_resultset $S] ne "SQLITE_OK"} break
  }
  sqlite3_finalize $S
  set r
} {0 1 2}

# It must keep reporting the segment while rows are being consumed, not only
# at a boundary -- that is the property a per-row consumer depends on.
do_test 3.1 {
  set S [sqlite3_prepare_v2 db {CALL atlas()} -1 TAIL]
  set r {}
  while {[sqlite3_step $S] eq "SQLITE_ROW"} {
    lappend r [sqlite3_proc_current_segment $S]
  }
  sqlite3_finalize $S
  set r
} {0 0}

# NEGATIVE CONTROL.  Without this, 3.0 passes against a function that returns
# a counter, an accessor wired to the wrong field, or one that never fails.
# A plain SELECT is not a CALL and must report -1.
do_test 3.2 {
  set S [sqlite3_prepare_v2 db {SELECT 1, 2} -1 TAIL]
  sqlite3_step $S
  set r [sqlite3_proc_current_segment $S]
  sqlite3_finalize $S
  set r
} {-1}

# A CALL of a procedure that declares NO shapes is also not segmented, so it
# must report -1 too -- "is a CALL" is not sufficient.
do_execsql_test 3.3 {
  CREATE PROCEDURE plain() BEGIN SELECT id FROM posts; END;
} {}
do_test 3.4 {
  set S [sqlite3_prepare_v2 db {CALL plain()} -1 TAIL]
  sqlite3_step $S
  set r [sqlite3_proc_current_segment $S]
  sqlite3_finalize $S
  set r
} {-1}

#--------------------------------------------------------------------
# 4.x: the CALL option bitmask (DOCKET 3h).  Syntax reserved before the merge
# driver exists, so the grammar is settled once; but INTERLEAVED is REFUSED
# rather than accepted-and-ignored.  A flag that parses and silently streams
# ordinary segments would have the client dispatching per row on a stream that
# is not interleaved -- a wrong answer wearing a working one's clothes.
#
# (updated 2026-08-06: the rewrite landed, so 4.0 now pins that the option
# DOES something -- 7 rows out of the atlas fixture; the full contract is 6.x)
do_test 4.0 {
  set S [sqlite3_prepare_v2 db {CALL atlas() WITH INTERLEAVED} -1 TAIL]
  set n 0
  while {[sqlite3_step $S] eq "SQLITE_ROW"} { incr n }
  sqlite3_finalize $S
  set n
} {7}

# Composition parses -- the options are a bitmask, not alternatives -- and the
# refusal still fires.  This is what proves the comma list works at all.
do_catchsql_test 4.1 {
  CALL atlas() WITH COUNTS, INTERLEAVED;
} {1 {WITH COUNTS may not be combined with INTERLEAVED yet}}

# REGRESSION CONTROL: the pre-existing option must still work.  Without this,
# 4.0 and 4.1 would pass just as well against a change that broke WITH COUNTS
# outright, since both only assert that something errors.
do_test 4.2 {
  set S [sqlite3_prepare_v2 db {CALL atlas() WITH COUNTS} -1 TAIL]
  sqlite3_step $S
  set r [list [sqlite3_proc_child_count $S 0] [sqlite3_proc_child_count $S 1]]
  sqlite3_finalize $S
  set r
} {2 1}

# An unknown word names both legal options rather than only the older one.
do_catchsql_test 4.3 {
  CALL atlas() WITH SPRINKLES;
} {1 {expected COUNTS or INTERLEAVED after WITH, got SPRINKLES}}

#--------------------------------------------------------------------
# 5.x: PRAGMA proc_nested -- the correlation metadata a generator stitches by
#
do_execsql_test 5.0 {
  PRAGMA proc_nested(atlas);
} {2 comments post_id id 3 tags post_id id}

# NEGATIVE control: a shapeless proc and a proc with no nesting emit nothing.
do_execsql_test 5.1 {
  PRAGMA proc_nested(plain);
} {}
do_execsql_test 5.2 {
  CREATE PROCEDURE flatshape() RETURNS TABLE(x INTEGER) BEGIN SELECT 1; END;
  PRAGMA proc_nested(flatshape);
} {}

#--------------------------------------------------------------------
# 6.x: WITH INTERLEAVED -- the tree rewrite (DOCKET 3h)
#
# One discriminated result set: _segment, _key, payload columns padded to the
# widest arm.  Child payloads are POSITIONAL (result column 2+j is child
# column j); visible names come from arm 0.
#
do_execsql_test 6.0 {
  CALL atlas() WITH INTERLEAVED;
} {0 1 1 first {} {} {} {} {} 1 1 {} {} 1 10 {} {} {} 1 1 {} {} 1 11 {} {} {} 2 1 {} {} {} {} 1 sql 5 0 2 2 second {} {} {} {} {} 1 2 {} {} 2 12 {} {} {} 2 2 {} {} {} {} 2 zig 7}

# The column-name contract: arm 0 names the compound.
do_test 6.1 {
  set S [sqlite3_prepare_v2 db {CALL atlas() WITH INTERLEAVED} -1 TAIL]
  sqlite3_step $S
  set r {}
  for {set i 0} {$i < [sqlite3_column_count $S]} {incr i} {
    lappend r [sqlite3_column_name $S $i]
  }
  sqlite3_finalize $S
  set r
} {_segment _key id title post_id cid post_id tag weight}

# Under interleaving there are no segment boundaries: current_segment is -1
# (the row's segment is the _segment COLUMN), and next_resultset is misuse.
do_test 6.2 {
  set S [sqlite3_prepare_v2 db {CALL atlas() WITH INTERLEAVED} -1 TAIL]
  sqlite3_step $S
  set r [list [sqlite3_proc_current_segment $S] [sqlite3_proc_next_resultset $S]]
  sqlite3_finalize $S
  set r
} {0 SQLITE_MISUSE}

# Refusals: compositions and shapes the rewrite cannot serve.
do_catchsql_test 6.3 {
  CALL atlas() WITH COUNTS, INTERLEAVED;
} {1 {WITH COUNTS may not be combined with INTERLEAVED yet}}
do_catchsql_test 6.4 {
  CALL atlas() RETURNING id WITH INTERLEAVED;
} {1 {RETURNING may not be combined with INTERLEAVED yet}}
do_catchsql_test 6.5 {
  CALL plain() WITH INTERLEAVED;
} {1 {procedure plain declares no nested table to interleave}}
do_execsql_test 6.6 {
  CREATE TABLE t_a(x INTEGER); CREATE TABLE t_b(y INTEGER);
  CREATE PROCEDURE dkey()
  RETURNS TABLE(a INTEGER, b INTEGER,
                xs TABLE(x INTEGER) KEY(x = a),
                ys TABLE(y INTEGER) KEY(y = b))
  BEGIN
    SELECT 1, 2;
    SELECT x FROM t_a;
    SELECT y FROM t_b;
  END;
} {}
do_catchsql_test 6.7 {
  CALL dkey() WITH INTERLEAVED;
} {1 {nested tables xs and ys of procedure dkey correlate on different parent columns (a vs b) and cannot share one interleaved order}}

# The segmented protocol is untouched by all of the above: the same walk as
# 1.1, byte-identical, is the regression control for this whole block.
do_test 6.8 {
  walk {CALL atlas()}
} {{4 id title comments tags} {2 post_id cid} {3 post_id tag weight}}

# An author ORDER BY inside a child survives the rewrite (the LIMIT -1
# anti-flattening).  cmt2 orders comments by cid DESC; within post 1 the
# comment rows must arrive 11 then 10.
do_execsql_test 6.9 {
  CREATE PROCEDURE atlas2()
  RETURNS TABLE(id INTEGER, title TEXT,
                comments TABLE(post_id INTEGER, cid INTEGER) KEY(post_id = id))
  BEGIN
    SELECT id, title FROM posts;
    SELECT post_id, cid FROM comments ORDER BY cid DESC;
  END;
} {}
do_execsql_test 6.10 {
  CALL atlas2() WITH INTERLEAVED;
} {0 1 1 first {} {} 1 1 {} {} 1 11 1 1 {} {} 1 10 0 2 2 second {} {} 1 2 {} {} 2 12}

# 6.11: the regression 6.10 exposed, pinned on the PLAIN path: a child with
# an author ORDER BY must still produce a real fold.  Before the fix the
# merge path returned without recording the fold recipe, and the flat client
# read a phantom column -- observed as 0.0 where the JSON belongs.
do_execsql_test 6.11 {
  CALL atlas2();
} {1 first [{"post_id":1,"cid":10},{"post_id":1,"cid":11}] 2 second [{"post_id":2,"cid":12}]}

# 6.12: and the guards the early return used to skip: LIMIT on an
# author-ORDERED child must be refused like LIMIT on any other child.
do_catchsql_test 6.12 {
  CREATE PROCEDURE badlim()
  RETURNS TABLE(id INTEGER,
                comments TABLE(post_id INTEGER, cid INTEGER) KEY(post_id = id))
  BEGIN
    SELECT id FROM posts;
    SELECT post_id, cid FROM comments ORDER BY cid DESC LIMIT 5;
  END;
} {1 {the SELECT for nested table comments of procedure badlim may not use LIMIT: its meaning per parent row is undefined}}

#--------------------------------------------------------------------
# 7.x: the sqlite3_proc_* READ FAMILY (UNGIT scar #3 companion)
#
# Per-segment metadata without moving the cursor, per-row values mapped by
# the row's own segment.  NOTE the deliberate asymmetry: SEGMENTED
# descriptors describe the wire (all declared columns, folds included);
# INTERLEAVED descriptors describe the disjoint payload (value columns
# only), because that is what each protocol actually carries.
#
do_test 7.0 {
  set S [sqlite3_prepare_v2 db {CALL atlas()} -1 TAIL]
  set r [list [sqlite3_proc_family $S segment_count]               [sqlite3_proc_family $S column_count 0]               [sqlite3_proc_family $S column_name 0 2]               [sqlite3_proc_family $S column_count 1]               [sqlite3_proc_family $S column_name 1 1]               [sqlite3_proc_family $S column_name 2 2]               [sqlite3_proc_family $S column_decltype 2 2]]
  sqlite3_finalize $S
  set r
} {3 4 comments 2 cid weight INTEGER}

do_test 7.1 {
  set S [sqlite3_prepare_v2 db {CALL atlas() WITH INTERLEAVED} -1 TAIL]
  set r [list [sqlite3_proc_family $S segment_count]               [sqlite3_proc_family $S column_count 0]               [sqlite3_proc_family $S column_name 0 1]               [sqlite3_proc_family $S column_name 1 0]               [sqlite3_proc_family $S column_name 2 2]]
  sqlite3_step $S            ;# parent row (1, first)
  lappend r [sqlite3_proc_current_segment $S]             [sqlite3_proc_family $S row_value 0]             [sqlite3_proc_family $S row_value 1]             [sqlite3_proc_family $S row_value 5]
  sqlite3_step $S            ;# first comment row (1, 10)
  lappend r [sqlite3_proc_current_segment $S]             [sqlite3_proc_family $S row_value 0]             [sqlite3_proc_family $S row_value 1]
  sqlite3_finalize $S
  set r
} {3 2 title post_id weight 0 1 first {} 1 1 10}

# NEGATIVE control: the family reports 0/{} off a plain SELECT, never a
# fabricated answer.
do_test 7.2 {
  set S [sqlite3_prepare_v2 db {SELECT 1,2} -1 TAIL]
  sqlite3_step $S
  set r [list [sqlite3_proc_family $S segment_count]               [sqlite3_proc_family $S column_name 0 0]               [sqlite3_proc_family $S row_value 0]]
  sqlite3_finalize $S
  set r
} {0 {} {}}

finish_test
