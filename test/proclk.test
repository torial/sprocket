#
# Lookaside-leak regression for generated folds.
#
# IMPORTANT: THESE CASES CANNOT FAIL IN A RELEASE BUILD.  The leak they guard
# is detected by assert(sqlite3LookasideUsed(db,0)==0) at connection teardown,
# and asserts are compiled out unless the fixture is built with DEBUG=3.  Run
# this file against a DEBUG=3 testfixture or it proves nothing.
#
# The bug: procWrapParent() called sqlite3SelectNew() with a NULL SrcList,
# which makes SelectNew allocate an empty one of its own, and then assigned
# over pWrap->pSrc -- orphaning that allocation.  One leaked lookaside block
# per generated fold.
#
# The five cases below are the bisection that located it, kept because each
# one exonerates a suspect the next would otherwise still implicate.

set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix proclk

ifcapable {!trigger} { finish_test ; return }

do_execsql_test 0.0 {
  CREATE TABLE posts(id INTEGER PRIMARY KEY, title TEXT);
  CREATE TABLE comments(cid INTEGER PRIMARY KEY, post_id INTEGER);
  INSERT INTO posts VALUES(1,'a'),(2,'b');
  INSERT INTO comments VALUES(1,1),(2,1),(3,2);
} {}

# 1. A plain declared procedure, never called -- exonerates the Proc object.
do_execsql_test 1.0 {
  CREATE PROCEDURE flat() RETURNS TABLE(id INTEGER, title TEXT)
  BEGIN SELECT id, title FROM posts; END;
} {}

# 2. The same, called -- exonerates the ordinary CALL codegen path.
do_test 2.0 { llength [execsql {CALL flat()}] } {4}

# 3. A nested procedure created but NOT called -- exonerates ProcFold, which
#    is allocated at CREATE.  This was the original suspect and was wrong.
do_execsql_test 3.0 {
  CREATE PROCEDURE pwc()
    RETURNS TABLE(id INTEGER, title TEXT,
                  comments TABLE(post_id INTEGER, cid INTEGER) KEY(post_id = id))
  BEGIN
    SELECT id, title FROM posts;
    SELECT post_id, cid FROM comments;
  END;
} {}

# 4. Called with the fold PROJECTED AWAY: procApplyFolds skips both the wrap
#    and the column, so no fold tree is built.  Clean here plus leaking in 5
#    is what put the leak inside fold generation specifically.
do_test 4.0 { llength [execsql {CALL pwc() RETURNING id, title}] } {4}

# 5. Called with the fold GENERATED -- the case that leaked.
do_test 5.0 { llength [execsql {CALL pwc()}] } {6}

# 6. Two nested tables in one shape: the wrap happens once but two fold
#    columns are added, so a per-fold leak would show twice as loudly.
do_execsql_test 6.0 {
  CREATE PROCEDURE two()
    RETURNS TABLE(id INTEGER,
                  a TABLE(post_id INTEGER, cid INTEGER) KEY(post_id = id),
                  b TABLE(post_id INTEGER, cid INTEGER) KEY(post_id = id))
  BEGIN
    SELECT id FROM posts;
    SELECT post_id, cid FROM comments;
    SELECT post_id, cid FROM comments;
  END;
} {}
do_test 6.1 { llength [execsql {CALL two()}] } {6}

finish_test
