#***********************************************************************
#
# Test cases for NESTED RESULT SHAPES on stored procedures:
#
#   RETURNS TABLE(id INTEGER, title TEXT,
#                 comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = id))
#
# covering the grammar and storage (PLAN-NESTED phase 1) and the CREATE-time
# conformance walk (phase 2), which requires the body to emit the parent
# SELECT followed by one SELECT per nested table.
#
# NOT covered here, because it does not exist yet: CALL of a nested procedure.
# Until phase 3 imposes the child ordering and phase 5 adds the flat-client
# column, a nested procedure streams its parent and child sets raw, which does
# not satisfy the invariant in PLAN-NESTED.md.  That is why this work is on a
# branch.

set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix proc6

ifcapable {!trigger} {
  finish_test
  return
}

do_execsql_test 0.0 {
  CREATE TABLE posts(id INTEGER PRIMARY KEY, title TEXT);
  CREATE TABLE comments(cid INTEGER PRIMARY KEY, post_id INTEGER, body TEXT);
  INSERT INTO posts VALUES(1,'first'),(2,'second');
  INSERT INTO comments VALUES(1,1,'a'),(2,1,'b'),(3,2,'c');
} {}

#--------------------------------------------------------------------
# 1.x: the grammar costs no keywords
#
# TABLE and KEY are both existing tokens, and KEY is in the non-reserved
# fallback list.  The fork's other keywords carry the guarantee that they
# remain usable as identifiers, and this one must too.
#
do_execsql_test 1.0 {
  CREATE TABLE key(key INTEGER, [table] TEXT);
  INSERT INTO key VALUES(1,'x');
  SELECT key, [table] FROM key;
} {1 x}

#--------------------------------------------------------------------
# 2.x: a conforming nested declaration is ACCEPTED
#
# This is the positive control for the whole file.  Every other test here
# asserts a rejection; without this one, a conformance walk that rejected
# every nested procedure would pass them all.
#
do_execsql_test 2.0 {
  CREATE PROCEDURE pwc(pid INTEGER)
    RETURNS TABLE(
      id INTEGER,
      title TEXT,
      comments TABLE(post_id INTEGER, cid INTEGER, body TEXT) KEY(post_id = id)
    )
  BEGIN
    SELECT id, title FROM posts WHERE id = pid;
    SELECT post_id, cid, body FROM comments WHERE post_id = pid;
  END;
} {}

# It survives a reopen: the declaration round-trips through sqlite_schema.
# Asserting the name alone would be satisfied by a re-parse that silently
# dropped the nesting, so this pins the nested column's position in the shape
# AND the CALL refusal, which is true only while pNested is actually present.
do_test 2.1 {
  db close
  sqlite3 db test.db
  execsql {
    SELECT resultset_index, position, name FROM pragma_proc_info('pwc')
     WHERE resultset_index = 1
  }
} {1 0 id 1 1 title 1 2 comments}

do_execsql_test 2.1b {
  CALL pwc(1);
} {1 first {[{"post_id":1,"cid":1,"body":"a"},{"post_id":1,"cid":2,"body":"b"}]}}

# Two nested tables in one shape: three SELECTs, parent first.
do_execsql_test 2.2 {
  CREATE PROCEDURE pwc2(pid INTEGER)
    RETURNS TABLE(
      id INTEGER,
      comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = id),
      tags TABLE(pid2 INTEGER, tag TEXT) KEY(pid2 = id)
    )
  BEGIN
    SELECT id FROM posts WHERE id = pid;
    SELECT post_id, body FROM comments WHERE post_id = pid;
    SELECT 1, 'x';
  END;
} {}

# A nested table in the SECOND of two declared shapes.
do_execsql_test 2.3 {
  CREATE PROCEDURE pwc3(pid INTEGER)
    RETURNS TABLE(n INTEGER)
    RETURNS TABLE(
      id INTEGER,
      comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = id)
    )
  BEGIN
    SELECT count(*) FROM posts;
    SELECT id FROM posts WHERE id = pid;
    SELECT post_id, body FROM comments WHERE post_id = pid;
  END;
} {}

# nresultsets counts SEGMENTS, not declared shapes.  pwc declares 1 shape
# holding 1 nested table = 2; pwc2 declares 1 shape holding 2 = 3; pwc3
# declares 2 shapes, one of which holds 1 nested table = 3.  Those three
# disagree with each other under any counting rule but the right one, so a
# helper stuck on "count shapes" or "count nested tables" cannot pass.
do_execsql_test 2.4 {
  SELECT name, nresultsets FROM pragma_proc_list
   WHERE name IN ('pwc','pwc2','pwc3') ORDER BY name;
} {pwc 2 pwc2 3 pwc3 3}

# CONTROL: a procedure that nests nothing still reports its shape count, so
# the redefinition is invisible to everything that existed before nesting.
do_execsql_test 2.5 {
  CREATE PROCEDURE twoflat(x INTEGER)
    RETURNS TABLE(a INTEGER) RETURNS TABLE(b INTEGER)
  BEGIN SELECT 1; SELECT 2; END;
  SELECT nresultsets FROM pragma_proc_list WHERE name = 'twoflat';
} {2}

#--------------------------------------------------------------------
# 3.x: phase 1 -- the declaration itself
#
# KEY's child half must name a column of the nested table.
do_catchsql_test 3.0 {
  CREATE PROCEDURE b1(pid INTEGER)
    RETURNS TABLE(id INTEGER,
                  comments TABLE(body TEXT) KEY(post_id = id))
  BEGIN SELECT 1; SELECT 'x'; END;
} {1 {KEY names post_id, which is not a column of the nested table}}

# KEY's parent half must name a column of the shape that contains it.  This
# is checked once the shape is complete, so it holds even when the nested
# table is declared BEFORE the column it correlates on.
do_catchsql_test 3.1 {
  CREATE PROCEDURE b2(pid INTEGER)
    RETURNS TABLE(id INTEGER,
                  comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = nope))
  BEGIN SELECT 1; SELECT 1,'x'; END;
} {1 {nested table comments of procedure b2 correlates on nope, which is not a column of the result set that contains it}}

do_execsql_test 3.2 {
  CREATE PROCEDURE fwd(pid INTEGER)
    RETURNS TABLE(comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = id),
                  id INTEGER)
  BEGIN
    SELECT id FROM posts WHERE id = pid;
    SELECT post_id, body FROM comments WHERE post_id = pid;
  END;
} {}

# Depth 2 is out of scope and is rejected explicitly rather than accepted
# and mishandled.
do_catchsql_test 3.3 {
  CREATE PROCEDURE b3(pid INTEGER)
    RETURNS TABLE(id INTEGER,
                  comments TABLE(post_id INTEGER,
                                 grand TABLE(g INTEGER) KEY(g = post_id))
                    KEY(post_id = id))
  BEGIN SELECT 1; END;
} {1 {procedure b3 streams 1 result set but declares 3}}
# (updated for PLAN-DEPTH: depth >= 2 is now ACCEPTED, so this fixture --
# whose body was written to never run -- fails conformance instead.  The new
# message is the better pin: it proves the deep declaration was accepted,
# expanded to three segments, and checked.  Depth-2 behavior proper lives in
# procdeep.test.)

# A shape that is nothing but nested tables has no column to correlate on.
do_catchsql_test 3.4 {
  CREATE PROCEDURE b4(pid INTEGER)
    RETURNS TABLE(comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = id))
  BEGIN SELECT 1; END;
} {1 {result set of procedure b4 declares only nested tables; a result set must have at least one column of its own to correlate on}}

#--------------------------------------------------------------------
# 4.x: phase 2 -- the body must emit parent then children, in order
#
# The child SELECT is missing entirely.
do_catchsql_test 4.0 {
  CREATE PROCEDURE m1(pid INTEGER)
    RETURNS TABLE(id INTEGER, title TEXT,
                  comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = id))
  BEGIN
    SELECT id, title FROM posts WHERE id = pid;
  END;
} {1 {procedure m1 streams 1 result set but declares 2}}

# Wrong arity on the child SELECT: the message names the nested table, not
# just the ordinal, because the author is looking at a body whose SELECTs
# have no labels.
do_catchsql_test 4.1 {
  CREATE PROCEDURE m2(pid INTEGER)
    RETURNS TABLE(id INTEGER, title TEXT,
                  comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = id))
  BEGIN
    SELECT id, title FROM posts WHERE id = pid;
    SELECT post_id, cid, body FROM comments WHERE post_id = pid;
  END;
} {1 {result set 2 of procedure m2 carries nested table comments, which declares 2 columns, but that SELECT has 3}}

# Wrong arity on the parent SELECT.  The message must not say "declares 2"
# against a RETURNS TABLE that visibly holds three entries.
do_catchsql_test 4.2 {
  CREATE PROCEDURE m3(pid INTEGER)
    RETURNS TABLE(id INTEGER, title TEXT,
                  comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = id))
  BEGIN
    SELECT id FROM posts WHERE id = pid;
    SELECT post_id, body FROM comments WHERE post_id = pid;
  END;
} {1 {result set 1 of procedure m3 has 1 column but its RETURNS TABLE declares 2 value columns before its 1 nested table, which are streamed by the SELECTs that follow}}

# Transposed: child SELECT first.  Caught because the arities differ.
do_catchsql_test 4.3 {
  CREATE PROCEDURE m4(pid INTEGER)
    RETURNS TABLE(id INTEGER,
                  comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = id))
  BEGIN
    SELECT post_id, body FROM comments WHERE post_id = pid;
    SELECT id FROM posts WHERE id = pid;
  END;
} {1 {result set 1 of procedure m4 has 2 columns but its RETURNS TABLE declares 1 value column before its 1 nested table, which are streamed by the SELECTs that follow}}

# One SELECT too many.
do_catchsql_test 4.4 {
  CREATE PROCEDURE m5(pid INTEGER)
    RETURNS TABLE(id INTEGER,
                  comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = id))
  BEGIN
    SELECT id FROM posts WHERE id = pid;
    SELECT post_id, body FROM comments WHERE post_id = pid;
    SELECT 1;
  END;
} {1 {procedure m5 streams more result sets than the 2 declared by its RETURNS clauses}}

# "*" is still refused, on a child SELECT as much as a parent one.
do_catchsql_test 4.5 {
  CREATE PROCEDURE m6(pid INTEGER)
    RETURNS TABLE(id INTEGER,
                  comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = id))
  BEGIN
    SELECT id FROM posts WHERE id = pid;
    SELECT * FROM comments WHERE post_id = pid;
  END;
} {1 {procedure m6 declares result shapes, so result set 2 may not use "*" -- list the columns explicitly}}

# RETURN mid-sequence, after the parent but before the child.
do_catchsql_test 4.6 {
  CREATE PROCEDURE m7(pid INTEGER)
    RETURNS TABLE(id INTEGER,
                  comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = id))
  BEGIN
    SELECT id FROM posts WHERE id = pid;
    RETURN;
  END;
} {1 {procedure m7 returns after streaming 1 of 2 declared result sets}}

# Branch symmetry still counts emissions, so a branch that streams the
# parent but not the child is caught.
do_catchsql_test 4.7 {
  CREATE PROCEDURE m8(pid INTEGER)
    RETURNS TABLE(id INTEGER,
                  comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = id))
  BEGIN
    SELECT id FROM posts WHERE id = pid;
    IF pid > 0 THEN
      SELECT post_id, body FROM comments WHERE post_id = pid;
    END IF;
  END;
} {1 {branches of IF in procedure m8 stream different numbers of result sets (2 and 1); every path must stream the declared sequence in order}}

#--------------------------------------------------------------------
# 4.8-4.9: the lowering refuses what it cannot honour
#
# The engine supplies the child ordering (PLAN-NESTED phase 3), so an ORDER BY
# the author wrote is refused rather than overridden -- overriding would
# discard their code silently, which is the failure class this phase exists to
# remove.  Merging (prepending the correlation term, so "ORDER BY created_at"
# sorts by date WITHIN a parent) is the documented growth path: refuse-to-merge
# breaks nothing later, merge-to-refuse would break bodies.
#
# An author ORDER BY is MERGED, not refused.  The correlation ordering is not a
# parameter -- nobody wants a different one.  The ordering WITHIN a group is,
# and its caller is easy to name: comments by date within each post.  Refusing
# both conflated two things wearing one signature.
do_execsql_test 4.8 {
  CREATE PROCEDURE o1(pid INTEGER)
    RETURNS TABLE(id INTEGER,
                  comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = id))
  BEGIN
    SELECT id FROM posts WHERE id = pid;
    SELECT post_id, body FROM comments WHERE post_id = pid ORDER BY body;
  END;
} {}

# LIMIT is refused because its meaning per parent row is undefined, and an
# imposed ORDER BY silently changes which rows it keeps.
# A compound child SELECT is refused: the imposed ORDER BY term is a copy of
# the leftmost arm's projection, which is not legal for a compound.
do_catchsql_test 4.8b {
  CREATE PROCEDURE o1b(pid INTEGER)
    RETURNS TABLE(id INTEGER,
                  comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = id))
  BEGIN
    SELECT id FROM posts WHERE id = pid;
    SELECT post_id, body FROM comments UNION ALL SELECT 1, 'x';
  END;
} {1 {the SELECT for nested table comments of procedure o1b may not be a compound SELECT}}

do_catchsql_test 4.9 {
  CREATE PROCEDURE o2(pid INTEGER)
    RETURNS TABLE(id INTEGER,
                  comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = id))
  BEGIN
    SELECT id FROM posts WHERE id = pid;
    SELECT post_id, body FROM comments WHERE post_id = pid LIMIT 5;
  END;
} {1 {the SELECT for nested table comments of procedure o2 may not use LIMIT: its meaning per parent row is undefined}}

# CONTROL: the restriction is on CHILD selects only.  A parent SELECT keeps its
# own ORDER BY and LIMIT, so the checks above cannot be refusing everything.
do_execsql_test 4.10 {
  CREATE PROCEDURE o3(pid INTEGER)
    RETURNS TABLE(id INTEGER,
                  comments TABLE(post_id INTEGER, body TEXT) KEY(post_id = id))
  BEGIN
    SELECT id FROM posts ORDER BY title LIMIT 3;
    SELECT post_id, body FROM comments WHERE post_id = pid;
  END;
} {}

# CONTROL: a procedure that nests nothing is untouched by the lowering.
do_execsql_test 4.11 {
  CREATE PROCEDURE o4(pid INTEGER) RETURNS TABLE(a INTEGER)
  BEGIN SELECT id FROM posts ORDER BY id LIMIT 1; END;
  CALL o4(1);
} {1}

#--------------------------------------------------------------------
# 5.x: nothing that did not nest behaves differently
#
# The flattened expectation must be identical to the old shape array when
# no column nests, or the diagnostics above would have drifted.
#
do_catchsql_test 5.0 {
  CREATE PROCEDURE f1(x INTEGER) RETURNS TABLE(a INTEGER, b TEXT)
  BEGIN SELECT 1; END;
} {1 {result set 1 of procedure f1 has 1 column but its RETURNS TABLE declares 2}}

do_execsql_test 5.1 {
  CREATE PROCEDURE f2(x INTEGER) RETURNS NOTHING
  BEGIN INSERT INTO posts VALUES(99,'n'); END;
  CALL f2(0);
  SELECT title FROM posts WHERE id = 99;
} {n}

#--------------------------------------------------------------------
# 6.x: what CALL of a nested procedure streams
#
# History worth keeping, because it is why the metadata is built the way it is.
# When the declared shape drove the result-column metadata directly,
# sqlite3_column_count reported the 3 DECLARED columns while the parent SELECT
# wrote 2 result registers, and "CALL pwc(1)" returned "1 first 0.0" -- a third
# value read from a register the body never assigned.  CALL was refused
# outright until the metadata was rebuilt per SEGMENT rather than per shape.
#
# The parent segment reports ALL its declared columns -- phase 5b generates a
# correlated subquery into the parent SELECT at each nested position, so the
# row genuinely has that many registers.  The nested table is ALSO streamed as
# the segment that follows, for segment-aware clients.  Both views coexist, at
# the cost measured in 8.5/8.6.
#
do_test 6.0 {
  set S [sqlite3_prepare_v2 db {CALL pwc(1)} -1 TAIL]
  set n [sqlite3_column_count $S]
  set nm {}
  for {set i 0} {$i < $n} {incr i} { lappend nm [sqlite3_column_name $S $i] }
  set rows {}
  while {[sqlite3_step $S] eq "SQLITE_ROW"} {
    lappend rows [sqlite3_column_text $S 1]
  }
  set adv [sqlite3_proc_next_resultset $S]
  set n2 [sqlite3_column_count $S]
  set nm2 {}
  for {set i 0} {$i < $n2} {incr i} { lappend nm2 [sqlite3_column_name $S $i] }
  sqlite3_finalize $S
  list $n $nm $rows $adv $n2 $nm2
} {3 {id title comments} first SQLITE_OK 3 {post_id cid body}}

# The refusal is about nesting, not about declared shapes: a procedure that
# declares a shape and nests nothing still calls.  Without this the guard
# could be refusing everything.
do_execsql_test 6.1 {
  CREATE PROCEDURE flat(pid INTEGER) RETURNS TABLE(id INTEGER, title TEXT)
  BEGIN SELECT id, title FROM posts WHERE id = pid; END;
  CALL flat(1);
} {1 first}

# Introspection exposes the nested table's OWN COLUMNS as the segment that
# follows its parent -- without this, procgen cannot see what to generate a
# child accessor from.  resultset_index therefore counts SEGMENTS, agreeing
# with proc_list.nresultsets and with sqlite3_proc_next_resultset().
#
# A nested column is recognisable in its parent set by an EMPTY decltype: a
# scalar column always has one, because CREATE requires it.
do_execsql_test 6.2 {
  SELECT resultset_index, position, name, decltype FROM pragma_proc_info('pwc');
} {0 0 pid INTEGER 1 0 id INTEGER 1 1 title TEXT 1 2 comments {} 2 0 post_id INTEGER 2 1 cid INTEGER 2 2 body TEXT}

# Two nested tables in one shape become two following segments, in declaration
# order -- which is how a client maps segment N back to the column it belongs
# to, since nothing else links them.
do_execsql_test 6.3 {
  SELECT resultset_index, position, name FROM pragma_proc_info('pwc2');
} {0 0 pid 1 0 id 1 1 comments 1 2 tags 2 0 post_id 2 1 body 3 0 pid2 3 1 tag}

#--------------------------------------------------------------------
# 7.x: the step model is lazy per ROW, which is what phase 5's fold rests on
#
# No nesting here on purpose -- this measures the two-segment behaviour a
# nested procedure will lower onto.  It lives in this file because it is the
# evidence for a design decision recorded in PLAN-NESTED.md (fold the nested
# column at the boundary API rather than in the VDBE), and evidence belongs
# next to the decision it supports.  If this ever goes red, that decision has
# to be revisited, not the test adjusted.
#
# THIS SECTION MUST STAY AFTER 2.1, which does "db close; sqlite3 db test.db".
# Moving it earlier silently discards the tally registration below, and 7.0
# then goes red for a reason that has nothing to do with what it measures.
#
# Section 8 re-pins this for an actual NESTED procedure, which was only
# measurable in a scratch build until the CALL guard was lifted.  The set
# boundary comes from the body's structure (each top-level SELECT ends a set),
# not from the number of declared shapes.
#
proc tally_cb {v} { incr ::nscan ; return $v }
db function tally tally_cb

# LIVENESS.  Expected magnitude stated first: 3 comment rows exist, so a
# working counter reads 3.  If this is not 3, every zero below is meaningless.
do_test 7.0 {
  set ::nscan 0
  execsql {SELECT tally(body) FROM comments}
  set ::nscan
} {3}

do_execsql_test 7.1 {
  CREATE PROCEDURE seg(pid INTEGER)
    RETURNS TABLE(id INTEGER, title TEXT)
    RETURNS TABLE(post_id INTEGER, cid INTEGER, body TEXT)
  BEGIN
    SELECT id, title FROM posts WHERE id = pid;
    SELECT post_id, cid, tally(body) FROM comments WHERE post_id = pid;
  END;
} {}

# Step set 1 to exhaustion, never advance to set 2, finalize.  The child query
# must not have run.  Post 1 has 2 comments, so a non-lazy path reads 2.
do_test 7.2 {
  set ::nscan 0
  set S [sqlite3_prepare_v2 db {CALL seg(1)} -1 TAIL]
  while {[sqlite3_step $S] eq "SQLITE_ROW"} {}
  sqlite3_finalize $S
  set ::nscan
} {0}

# CONTROL: the same statement text and the same UDF, advanced into set 2.
# The only variable between this and 7.2 is next_resultset, so the zero above
# cannot be a UDF the body never calls.
do_test 7.3 {
  set ::nscan 0
  set S [sqlite3_prepare_v2 db {CALL seg(1)} -1 TAIL]
  while {[sqlite3_step $S] eq "SQLITE_ROW"} {}
  sqlite3_proc_next_resultset $S
  while {[sqlite3_step $S] eq "SQLITE_ROW"} {}
  sqlite3_finalize $S
  set ::nscan
} {2}

# One step into set 2 scans exactly one row.  This separates "lazy per
# segment" from "lazy per row"; only the latter lets a boundary fold decline
# work the client did not ask for.
do_test 7.4 {
  set ::nscan 0
  set S [sqlite3_prepare_v2 db {CALL seg(1)} -1 TAIL]
  while {[sqlite3_step $S] eq "SQLITE_ROW"} {}
  sqlite3_proc_next_resultset $S
  sqlite3_step $S
  set n $::nscan
  sqlite3_finalize $S
  set n
} {1}

#--------------------------------------------------------------------
# 8.x: the imposed ordering, end to end
#
# Its own fixture, because the ordering can only be demonstrated when the
# child table's SCAN order differs from its KEY order.  Comments are inserted
# so that rowid order gives post_ids 2 1 2 1 while key order gives 1 1 2 2 --
# two answers that cannot be confused for one another.
#
do_execsql_test 8.0 {
  CREATE TABLE p2(id INTEGER PRIMARY KEY);
  CREATE TABLE c2(cid INTEGER PRIMARY KEY, pid INTEGER);
  INSERT INTO p2 VALUES(1),(2);
  INSERT INTO c2 VALUES(1,2),(2,1),(3,2),(4,1);
  SELECT pid FROM c2;
} {2 1 2 1}

proc seg2keys {sql} {
  set S [sqlite3_prepare_v2 db $sql -1 TAIL]
  while {[sqlite3_step $S] eq "SQLITE_ROW"} {}
  set adv [sqlite3_proc_next_resultset $S]
  set r {}
  if {$adv eq "SQLITE_OK"} {
    while {[sqlite3_step $S] eq "SQLITE_ROW"} { lappend r [sqlite3_column_int $S 0] }
  }
  sqlite3_finalize $S
  return $r
}

# CONTROL: an identical body whose second SELECT feeds a DECLARED SHAPE rather
# than a nested table gets no ordering, so it returns scan order.  Without this
# the grouped result below would not distinguish the engine's work from the
# table happening to be stored that way.
do_execsql_test 8.1 {
  CREATE PROCEDURE ord_flat() RETURNS TABLE(id INTEGER)
                              RETURNS TABLE(pid INTEGER, cid INTEGER)
  BEGIN SELECT id FROM p2; SELECT pid, cid FROM c2; END;
} {}
do_test 8.2 { seg2keys {CALL ord_flat()} } {2 1 2 1}

# THE MEASUREMENT: same body, second SELECT feeds a nested table.
do_execsql_test 8.3 {
  CREATE PROCEDURE ord_nest()
    RETURNS TABLE(id INTEGER,
                  kids TABLE(pid INTEGER, cid INTEGER) KEY(pid = id))
  BEGIN SELECT id FROM p2; SELECT pid, cid FROM c2; END;
} {}
do_test 8.4 { seg2keys {CALL ord_nest()} } {1 1 2 2}
# Observed red, not merely believed capable of it: with the pOrderBy assignment
# in procLowerChild disabled, 8.4 -- and 8.4 ALONE out of 46 -- returns
# 2 1 2 1.  Wrong grouping, no error: POC 2's signature exactly.  Nothing else
# in this suite detects the ordering, which is why this case matters.

do_execsql_test 8.4b {
  CREATE PROCEDURE lazy_nest()
    RETURNS TABLE(id INTEGER,
                  kids TABLE(pid INTEGER, cid INTEGER) KEY(pid = id))
  BEGIN SELECT id FROM p2; SELECT pid, tally(cid) FROM c2; END;
} {}

# LAZINESS IS GONE, AND THESE NUMBERS ARE THE PROBLEM RATHER THAN THE GOAL.
# Phase 5b puts the flat-client column in the PARENT SELECT as a correlated
# subquery, so stepping the parent segment scans the children (4) even though
# nothing read the column -- and a segment-aware client that then reads the
# child segment scans them AGAIN (8).
#
# The design note predicted the first of these and claimed segment-aware
# clients were unaffected.  Measurement says otherwise: they pay twice.  The
# typed path was the performance-motivated one, so this is a regression for the
# client the feature exists to serve, not a tolerable cost on a fallback path.
#
# Pinned at the measured values so the fix is visible when it lands: an opt-out
# at prepare (DOCKET 3c) must return 8.5 to 0 and 8.6 to 4.
do_test 8.5 {
  set ::nscan 0
  set S [sqlite3_prepare_v2 db {CALL lazy_nest()} -1 TAIL]
  while {[sqlite3_step $S] eq "SQLITE_ROW"} {}
  sqlite3_finalize $S
  set ::nscan
} {4}
do_test 8.6 {
  set ::nscan 0
  set S [sqlite3_prepare_v2 db {CALL lazy_nest()} -1 TAIL]
  while {[sqlite3_step $S] eq "SQLITE_ROW"} {}
  sqlite3_proc_next_resultset $S
  while {[sqlite3_step $S] eq "SQLITE_ROW"} {}
  sqlite3_finalize $S
  set ::nscan
} {8}

#--------------------------------------------------------------------
# 9.x: the merged ordering -- key first, author's terms after
#
# The proof is a fixture where the two orderings DISAGREE: children whose
# alphabetical order by body is the reverse of their key order.  If the key
# term were not prepended, the rows would come back sorted by body alone.
#
do_execsql_test 9.0 {
  CREATE TABLE p3(id INTEGER PRIMARY KEY);
  CREATE TABLE c3(cid INTEGER PRIMARY KEY, pid INTEGER, body TEXT);
  INSERT INTO p3 VALUES(1),(2);
  -- Rows interleave the parents in SCAN order, so that scan order differs from
  -- BOTH expected results below.  An earlier fixture had scan order equal to
  -- the DESC case by coincidence, and 9.4 passed with the key prepend disabled
  -- -- green for a reason unrelated to the feature, found by breaking it.
  INSERT INTO c3 VALUES(1,2,'y'),(2,1,'z'),(3,1,'a'),(4,2,'b');
  SELECT pid||body FROM c3;
} {2y 1z 1a 2b}

do_execsql_test 9.1 {
  CREATE PROCEDURE merged()
    RETURNS TABLE(id INTEGER,
                  kids TABLE(pid INTEGER, body TEXT) KEY(pid = id))
  BEGIN
    SELECT id FROM p3;
    SELECT pid, body FROM c3 ORDER BY body;
  END;
} {}

# Grouped by key FIRST, then alphabetical within each group: 1a 1z 2b 2y.
# Sorted by body alone would be a,b,y,z -- interleaving the parents.
do_test 9.2 {
  set S [sqlite3_prepare_v2 db {CALL merged() RETURNING id} -1 T]
  while {[sqlite3_step $S] eq "SQLITE_ROW"} {}
  sqlite3_proc_next_resultset $S
  set r {}
  while {[sqlite3_step $S] eq "SQLITE_ROW"} {
    lappend r [sqlite3_column_int $S 0][sqlite3_column_text $S 1]
  }
  sqlite3_finalize $S
  set r
} {1a 1z 2b 2y}

# DESC on the author's term is preserved -- the merge keeps sort flags.
do_execsql_test 9.3 {
  CREATE PROCEDURE merged2()
    RETURNS TABLE(id INTEGER,
                  kids TABLE(pid INTEGER, body TEXT) KEY(pid = id))
  BEGIN
    SELECT id FROM p3;
    SELECT pid, body FROM c3 ORDER BY body DESC;
  END;
} {}
do_test 9.4 {
  set S [sqlite3_prepare_v2 db {CALL merged2() RETURNING id} -1 T]
  while {[sqlite3_step $S] eq "SQLITE_ROW"} {}
  sqlite3_proc_next_resultset $S
  set r {}
  while {[sqlite3_step $S] eq "SQLITE_ROW"} {
    lappend r [sqlite3_column_int $S 0][sqlite3_column_text $S 1]
  }
  sqlite3_finalize $S
  set r
} {1z 1a 2y 2b}

finish_test
