#
# Does any of this actually pay?  The whole design argues from performance --
# stored procedures to avoid round trips, nested shapes to avoid N+1 -- and
# until now nobody had measured it.
#
# Measured in VDBE STEPS, not wall clock.  A step count is deterministic and
# does not care that the machine is busy, which is the rule this fork already
# wrote down: a count is no better than a stopwatch when the count is itself
# timing-dependent.  This one is not.
#
# WHAT THIS DOES NOT MEASURE: round trips.  Locally, N+1 costs 200 statement
# executions in the same process.  Over the wire it costs 200 ROUND TRIPS
# against one, and no VDBE counter can see that.  So these numbers are the
# DATA-LOCAL case, which is the case that motivated the fork -- and they
# understate the procedure paths everywhere else.

set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix procbench

# 200 parents x 5 children.  Small enough to run instantly, large enough that
# per-parent overhead dominates -- which is the regime the design targets.
do_test 0.0 {
  execsql {
    CREATE TABLE posts(id INTEGER PRIMARY KEY, title TEXT);
    CREATE TABLE comments(cid INTEGER PRIMARY KEY, post_id INTEGER, body TEXT);
  }
  db transaction {
    for {set i 1} {$i <= 200} {incr i} {
      execsql {INSERT INTO posts VALUES($i, 'post')}
      for {set j 0} {$j < 5} {incr j} {
        execsql {INSERT INTO comments(post_id, body) VALUES($i, 'c')}
      }
    }
  }
  execsql {CREATE INDEX cpost ON comments(post_id)}
  execsql {SELECT (SELECT count(*) FROM posts), (SELECT count(*) FROM comments)}
} {200 1000}

proc vmsteps {S} { sqlite3_stmt_status $S SQLITE_STMTSTATUS_VM_STEP 0 }

# A: the N+1 a naive ORM issues -- one parent query, then one child query per
#    parent row.  This is what the whole design exists to replace.
do_test 1.0 {
  set P [sqlite3_prepare_v2 db {SELECT id, title FROM posts} -1 T]
  set C [sqlite3_prepare_v2 db {SELECT post_id, cid, body FROM comments WHERE post_id = ?} -1 T]
  set nrow 0
  while {[sqlite3_step $P] eq "SQLITE_ROW"} {
    incr nrow
    sqlite3_reset $C
    sqlite3_bind_int $C 1 [sqlite3_column_int $P 0]
    while {[sqlite3_step $C] eq "SQLITE_ROW"} {}
  }
  set v [expr {[vmsteps $P] + [vmsteps $C]}]
  sqlite3_finalize $P
  sqlite3_finalize $C
  list $nrow $v
  set ::vmNplus1 $v
  list $nrow [expr {$v > 0}]
} {200 1}

do_execsql_test 2.0 {
  CREATE PROCEDURE pwc()
    RETURNS TABLE(id INTEGER, title TEXT,
                  comments TABLE(post_id INTEGER, cid INTEGER, body TEXT)
                    KEY(post_id = id))
  BEGIN
    SELECT id, title FROM posts;
    SELECT post_id, cid, body FROM comments;
  END;
} {}

# B: segments -- the typed path.  One pass over each table, no fold generated.
do_test 2.1 {
  set S [sqlite3_prepare_v2 db {CALL pwc() RETURNING id, title} -1 T]
  set nrow 0
  while {[sqlite3_step $S] eq "SQLITE_ROW"} { incr nrow }
  sqlite3_proc_next_resultset $S
  while {[sqlite3_step $S] eq "SQLITE_ROW"} {}
  set v [vmsteps $S]
  sqlite3_finalize $S
  list $nrow $v
  set ::vmSeg $v
  list $nrow [expr {$v > 0}]
} {200 1}

# C: the folded JSON -- what a flat client gets.
do_test 2.2 {
  set S [sqlite3_prepare_v2 db {CALL pwc()} -1 T]
  set nrow 0
  while {[sqlite3_step $S] eq "SQLITE_ROW"} { incr nrow }
  set v [vmsteps $S]
  sqlite3_finalize $S
  list $nrow $v
  set ::vmFold $v
  list $nrow [expr {$v > 0}]
} {200 1}

#--------------------------------------------------------------------
# The findings, pinned as RELATIONSHIPS rather than absolute counts.  Exact
# step counts are deterministic but move with any codegen change, which would
# make this file noise.  The orderings are the claims worth defending.
#
# Measured 2026-08-04 on 200 parents x 5 children:
#     N+1      9805
#     segments 6815   -- 30% less work than N+1
#     folded  17408   -- 1.8x MORE work than N+1

# 1. THE DESIGN'S PREMISE HOLDS FOR THE TYPED PATH.  Segments beat N+1: one
#    pass over each table instead of one query per parent.
do_test 3.0 { expr {$::vmSeg < $::vmNplus1} } {1}

# 2. THE FOLD IS NOT A PERFORMANCE FEATURE, AND THIS IS THE UNCOMFORTABLE ONE.
#    The folded JSON costs MORE than the N+1 it was meant to improve on --
#    because it IS an N+1 (a correlated subquery per parent row) plus JSON
#    construction on top.  It exists so an unmodified client works at all.
#    It is a COMPATIBILITY feature that happens to cost, not an optimisation.
#
#    If this ever goes red because folding got cheaper, that is good news and
#    the comment above needs rewriting -- not the test.
do_test 3.1 { expr {$::vmFold > $::vmNplus1} } {1}

# 3. Which is why DOCKET 3c exists: a typed client projects the fold away and
#    pays neither cost.  Zebra's ORM should use the SEGMENT path.
do_test 3.2 { expr {$::vmSeg < $::vmFold} } {1}

finish_test
