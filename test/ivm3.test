#
# PLAN-IVM3 -- Tier 2 stage two: inner joins in materialized views.
# THIS FILE IS WRITTEN RED, ON PURPOSE, BEFORE THE FEATURE EXISTS.
# The file going green is the campaign's definition of done.
#
# Do not adjust an expectation here to make the suite pass.  If an
# expectation is wrong, PLAN-IVM3.md changes first, with the reason.

set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix ivm3

#--------------------------------------------------------------------
# 1.x: acceptance and refusals (P1/P2)
#
do_execsql_test 1.0 {
  CREATE TABLE posts(id INTEGER PRIMARY KEY, author TEXT NOT NULL);
  CREATE TABLE comments(cid INTEGER PRIMARY KEY, post_id INTEGER,
                        score INTEGER);
  INSERT INTO posts VALUES(1,'ann'),(2,'bob');
  INSERT INTO comments VALUES(10,1,5),(11,1,7),(12,2,3);
  CREATE MATERIALIZED VIEW activity AS
    SELECT p.author, count(*) AS nc, total(c.score) AS total
      FROM posts p JOIN comments c ON c.post_id = p.id
     GROUP BY p.author;
  SELECT author, nc, total FROM activity ORDER BY author;
} {ann 2 12.0 bob 1 3.0}

# Self-joins: the one-row shadow would replace BOTH occurrences.
do_catchsql_test 1.1 {
  CREATE MATERIALIZED VIEW bad1 AS
    SELECT a.author, count(*) FROM posts a, posts b GROUP BY a.author;
} {1 {bad1 cannot be incrementally maintained: posts appears more than once (self-joins are not yet maintainable)}}

# Outer joins: membership changes flip null-extended rows (Tier 3).
do_catchsql_test 1.2 {
  CREATE MATERIALIZED VIEW bad2 AS
    SELECT p.author, count(c.cid)
      FROM posts p LEFT JOIN comments c ON c.post_id = p.id
     GROUP BY p.author;
} {1 {bad2 cannot be incrementally maintained: outer joins are not yet supported (a departing row can flip null-extended rows on the other side)}}

# Non-deterministic join conditions refuse like any condition.
do_catchsql_test 1.3 {
  CREATE MATERIALIZED VIEW bad3 AS
    SELECT p.author, count(*)
      FROM posts p JOIN comments c ON c.post_id = p.id AND random()>0
     GROUP BY p.author;
} {1 {bad3 cannot be incrementally maintained: random() is non-deterministic; a maintained view's definition may not depend on when it is evaluated}}

# Join views carry no hidden bookkeeping: what cannot be derived must
# be declared or refused.  SUM's NULL-restoring count is underivable
# across a join.
do_catchsql_test 1.3b {
  CREATE MATERIALIZED VIEW bad4 AS
    SELECT p.author, count(*) AS n, sum(c.score) AS s
      FROM posts p JOIN comments c ON c.post_id = p.id
     GROUP BY p.author;
} {1 {bad4 cannot be incrementally maintained: sum() is not yet maintainable in a join view (its NULL-restoring count cannot be derived across a join); use total()}}

# count(*) IS a join view's group liveness; it must be declared.
do_catchsql_test 1.3c {
  CREATE MATERIALIZED VIEW bad5 AS
    SELECT p.author, total(c.score) AS s
      FROM posts p JOIN comments c ON c.post_id = p.id
     GROUP BY p.author;
} {1 {bad5 cannot be incrementally maintained: a join view must declare count(*) (the group's liveness cannot be derived across a join)}}

# Three tables work: the construction is per-base, not pairwise.
do_execsql_test 1.4 {
  CREATE TABLE tags3(tid INTEGER PRIMARY KEY, cid INTEGER, tag TEXT);
  INSERT INTO tags3 VALUES(100,10,'hot'),(101,11,'new'),(102,12,'hot');
  CREATE MATERIALIZED VIEW tagged AS
    SELECT t.tag, count(*) AS n
      FROM posts p JOIN comments c ON c.post_id = p.id
                   JOIN tags3 t ON t.cid = c.cid
     GROUP BY t.tag;
  SELECT tag, n FROM tagged ORDER BY tag;
} {hot 2 new 1}

#--------------------------------------------------------------------
# 2.x: eager maintenance from every side (P3)
#
do_execsql_test 2.0 {
  INSERT INTO comments VALUES(13,2,9);          -- child side
  SELECT nc, total FROM activity WHERE author='bob';
} {2 12.0}

do_execsql_test 2.1 {
  DELETE FROM comments WHERE cid=13;
  SELECT nc, total FROM activity WHERE author='bob';
} {1 3.0}

do_execsql_test 2.2 {
  UPDATE comments SET post_id=2 WHERE cid=11;   -- join-key move ann->bob
  SELECT author, nc, total FROM activity ORDER BY author;
} {ann 1 5.0 bob 2 10.0}

do_execsql_test 2.3 {
  DELETE FROM posts WHERE id=1;                 -- parent side: group dies
  SELECT author, nc, total FROM activity ORDER BY author;
} {bob 2 10.0}

do_execsql_test 2.4 {
  INSERT INTO posts VALUES(3,'cec');            -- parent with no children
  SELECT count(*) FROM activity WHERE author='cec';
} {0}

do_execsql_test 2.5 {
  INSERT INTO comments VALUES(14,3,1);          -- first join row births it
  SELECT nc, total FROM activity WHERE author='cec';
} {1 1.0}

do_execsql_test 2.6 {
  UPDATE posts SET author='dan' WHERE id=3;     -- group re-keys
  SELECT author, nc, total FROM activity WHERE author IN ('cec','dan')
   ORDER BY author;
} {dan 1 1.0}

# The three-way view moved with everything above.
do_execsql_test 2.7 {
  SELECT count(*) FROM pragma_view_check WHERE kind='diff';
} {0}

#--------------------------------------------------------------------
# 3.x: an extremum over a join, and its rescan (stage-one machinery
# composing with stage two)
#
do_execsql_test 3.0 {
  CREATE MATERIALIZED VIEW best AS
    SELECT p.author, max(c.score) AS top, count(*) AS n
      FROM posts p JOIN comments c ON c.post_id = p.id
     GROUP BY p.author;
  SELECT author, top FROM best ORDER BY author;
} {bob 7 dan 1}

do_execsql_test 3.1 {
  DELETE FROM comments WHERE cid=11;            -- bob's max (7): rescan
  SELECT top FROM best WHERE author='bob';
} {3}

do_execsql_test 3.2 {
  SELECT count(*) FROM pragma_view_check('best') WHERE kind='diff';
} {0}

#--------------------------------------------------------------------
# 4.x: probe economics, MEASURED (P3 gate).  A child-side insert probes
# posts by its PRIMARY KEY: zero full scans.  A parent-side delete
# probes comments by post_id, which has no index yet: full scans, which
# is exactly what the 5.x advisory removes.
#
proc opsteps {sql} {
  set S [sqlite3_prepare_v2 db $sql -1 TAIL]
  sqlite3_step $S
  set n [sqlite3_stmt_status $S SQLITE_STMTSTATUS_FULLSCAN_STEP 0]
  sqlite3_finalize $S
  return $n
}
# Baseline, then inflate the PROBED side with join-inert rows: an
# indexed probe's cost must not grow with the other table.
do_test 4.0 {
  set ::n1 [opsteps {INSERT INTO comments VALUES(15,2,4)}]
  db eval {WITH RECURSIVE g(i) AS (SELECT 1000 UNION ALL SELECT i+1 FROM g WHERE i<1059)
           INSERT INTO posts SELECT i, 'filler'||i FROM g}
  set ::n2 [opsteps {INSERT INTO comments VALUES(16,2,6)}]
  expr {$::n2 == $::n1}
} {1}
# The unindexed direction grows with the probed table...
do_test 4.1 {
  set ::d1 [opsteps {DELETE FROM comments WHERE cid=16}]
  db eval {WITH RECURSIVE g(i) AS (SELECT 2000 UNION ALL SELECT i+1 FROM g WHERE i<2059)
           INSERT INTO comments SELECT i, NULL, 0 FROM g}
  set ::d2 [opsteps {DELETE FROM posts WHERE id=3}]
  expr {$::d2 > $::d1 + 50}
} {1}

#--------------------------------------------------------------------
# 5.x: the join-probe advisory (P4).  posts is probed by its PK
# (silent); comments(post_id) is missing (fires); tags3(cid) is missing
# on the three-way view (fires there).  The carried statement runs
# verbatim and the advisory goes silent.
#
do_execsql_test 5.0 {
  SELECT count(*) FROM pragma_view_check('activity')
   WHERE kind='advisory';
} {1}
do_execsql_test 5.1 {
  SELECT detail LIKE 'CREATE INDEX%comments%post_id%'
    FROM pragma_view_check('activity') WHERE kind='advisory';
} {1}
do_test 5.2 {
  set stmt [db one {SELECT detail FROM pragma_view_check('activity')
                     WHERE kind='advisory'}]
  db eval $stmt
  db eval {SELECT count(*) FROM pragma_view_check('activity')
            WHERE kind='advisory'}
} {0}
# ...and stops growing once the advisory's own statement has run:
# comments is still inflated, but the delete now probes by index.
do_test 5.3 {
  expr {[opsteps {DELETE FROM posts WHERE id=2}] < $::d2}
} {1}
do_execsql_test 5.4 {
  SELECT author, nc FROM activity;
} {}

#--------------------------------------------------------------------
# 6.x: a deferred join view; the fold and repair are source-agnostic
#
do_execsql_test 6.0 {
  INSERT INTO posts VALUES(4,'eve'),(5,'fay');
  INSERT INTO comments VALUES(20,4,2),(21,4,8),(22,5,6);
  CREATE MATERIALIZED VIEW lazyact WITH MAINTENANCE DEFERRED AS
    SELECT p.author, count(*) AS nc, max(c.score) AS top
      FROM posts p JOIN comments c ON c.post_id = p.id
     GROUP BY p.author;
  INSERT INTO comments VALUES(23,5,9);
  DELETE FROM comments WHERE cid=21;            -- eve's max, logged
  SELECT (SELECT count(*) FROM lazyact),
         (SELECT pending FROM pragma_view_list WHERE name='lazyact');
} {2 2}
do_execsql_test 6.1 {
  PRAGMA view_refresh(lazyact);
  SELECT author, nc, top FROM lazyact ORDER BY author;
} {eve 1 2 fay 2 9}
do_execsql_test 6.2 {
  SELECT count(*) FROM pragma_view_check('lazyact') WHERE kind='diff';
} {0}

#--------------------------------------------------------------------
# 7.x: the storm (campaign acceptance) -- churn on both tables
#
do_test 7.0 {
  set ops 0
  foreach {pid author} {6 gil 7 hal 8 ida} {
    db eval {INSERT INTO posts VALUES($pid, $author)}
    incr ops
  }
  foreach {cid pid sc} {
    30 6 5  31 6 2  32 7 9  33 8 4  34 6 7  35 7 1  36 8 8  37 7 3
  } {
    db eval {INSERT INTO comments VALUES($cid, $pid, $sc)}
    incr ops
  }
  db eval {DELETE FROM comments WHERE score IN (2, 9)}
  db eval {UPDATE comments SET post_id=6 WHERE cid=33}
  db eval {UPDATE posts SET author='gil2' WHERE id=6}
  db eval {DELETE FROM posts WHERE id=7}
  db eval {PRAGMA view_refresh}
  list $ops [db eval {
    SELECT count(*) FROM pragma_view_check WHERE kind='diff'}]
} {11 0}

#--------------------------------------------------------------------
# 8.x: reopen -- every base's trigger set re-synthesizes at load
#
db close
sqlite3 db test.db
do_execsql_test 8.0 {
  INSERT INTO comments VALUES(40,8,6);
  SELECT nc FROM activity WHERE author='ida';
} {2}
do_execsql_test 8.1 {
  DELETE FROM posts WHERE id=8;
  SELECT count(*) FROM activity WHERE author='ida';
} {0}
do_execsql_test 8.2 {
  PRAGMA view_refresh;
  SELECT count(*) FROM pragma_view_check WHERE kind='diff';
} {0}

finish_test
