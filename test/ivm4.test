# 2026-08-16
#
# IVM4 -- REPLACE displacement reaches maintenance.
#
# Found by DESIGN-IVM-TEMPORAL's POC-T3 before its campaign even
# opened: under PRAGMA recursive_triggers=OFF (the default), a
# REPLACE-displaced base row never fed the synthesized maintenance
# triggers, so an eager mview silently kept counting a row that no
# longer existed (view_check caught it; eager maintenance did not).
# The fix exempts the engine's own capture from the recursive_triggers
# gate on the displacement path while keeping USER delete triggers
# gated exactly as upstream.  temporal1 section 12 pins the temporal
# side of the same fix.
#
set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix ivm4

# 1: PK displacement under recursive_triggers=OFF
do_execsql_test 1.0 {
  PRAGMA recursive_triggers=OFF;
  CREATE TABLE t(id INTEGER PRIMARY KEY, grp INTEGER, x INTEGER);
  CREATE MATERIALIZED VIEW mv AS
    SELECT grp, count(*) AS n, sum(x) AS s FROM t GROUP BY grp;
  INSERT INTO t VALUES(1, 1, 10);
  INSERT INTO t VALUES(2, 1, 20);
  REPLACE INTO t(id, grp, x) VALUES(1, 2, 99);
  SELECT grp, n, s FROM mv ORDER BY grp;
} {1 1 20 2 1 99}
do_execsql_test 1.1 {
  SELECT detail FROM pragma_view_check('mv') WHERE kind='summary';
} {{2 groups compared, 0 differ}}

# 2: UNIQUE displacement (victim has a different PK)
do_execsql_test 2.0 {
  CREATE TABLE t2(id INTEGER PRIMARY KEY, u TEXT UNIQUE, x INTEGER);
  CREATE MATERIALIZED VIEW mv2 AS
    SELECT count(*) AS n, sum(x) AS s FROM t2;
  INSERT INTO t2 VALUES(1, 'alpha', 5);
  REPLACE INTO t2 VALUES(2, 'alpha', 7);
  SELECT n, s FROM mv2;
} {1 7}
do_execsql_test 2.1 {
  SELECT detail FROM pragma_view_check('mv2') WHERE kind='summary';
} {{1 groups compared, 0 differ}}

# 3: UPDATE OR REPLACE displaces through the same shared path
do_execsql_test 3.0 {
  INSERT INTO t2 VALUES(3, 'beta', 11);
  UPDATE OR REPLACE t2 SET u='alpha' WHERE id=3;
  SELECT n, s FROM mv2;
} {1 11}
do_execsql_test 3.1 {
  SELECT detail FROM pragma_view_check('mv2') WHERE kind='summary';
} {{1 groups compared, 0 differ}}

# 4: user delete triggers stay gated on the pragma (upstream
# semantics preserved -- only engine capture is exempt)
do_execsql_test 4.0 {
  CREATE TABLE audit(msg TEXT);
  CREATE TRIGGER t2_userdel AFTER DELETE ON t2 BEGIN
    INSERT INTO audit VALUES(OLD.id);
  END;
  INSERT INTO t2 VALUES(5, 'gamma', 1);
  REPLACE INTO t2 VALUES(6, 'gamma', 2);
  SELECT (SELECT count(*) FROM audit), (SELECT n FROM mv2);
} {0 2}
do_execsql_test 4.1 {
  PRAGMA recursive_triggers=ON;
  INSERT INTO t2 VALUES(7, 'delta', 3);
  REPLACE INTO t2 VALUES(8, 'delta', 4);
  SELECT (SELECT count(*) FROM audit), (SELECT n FROM mv2);
} {1 3}

finish_test
