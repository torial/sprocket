#***********************************************************************
#
# PLAN-NESTED phase 6 / DOCKET R7 -- the index advisory.  WRITTEN RED, BEFORE
# THE FEATURE.  Do not adjust an expectation to make it pass.
#
# The engine imposes the child ordering (phase 3), so the author never writes
# it -- and therefore never sees that it costs a sort when no index supplies
# it.  Making the engine responsible for the ordering makes it responsible for
# saying when the ordering is expensive.
#
# It is ADVISORY, never an error: a ten-row child table does not need an index
# and the author may know better.  Both directions must be demonstrated or it
# is not a detector.

set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix proc6adv

ifcapable {!trigger} { finish_test ; return }

db close
sqlite3_shutdown
test_sqlite3_log [list lappend ::log]
set ::log [list]
sqlite3 db test.db

do_execsql_test 0.0 {
  CREATE TABLE posts(id INTEGER PRIMARY KEY, title TEXT);
  CREATE TABLE comments(cid INTEGER PRIMARY KEY, post_id INTEGER);
  INSERT INTO posts VALUES(1,'a'),(2,'b');
  INSERT INTO comments VALUES(1,1),(2,2),(3,1);
  CREATE PROCEDURE pwc()
    RETURNS TABLE(id INTEGER, title TEXT,
                  comments TABLE(post_id INTEGER, cid INTEGER) KEY(post_id = id))
  BEGIN
    SELECT id, title FROM posts;
    SELECT post_id, cid FROM comments;
  END;
} {}

#--------------------------------------------------------------------
# 1.x: unindexed correlation advises, and the CALL still works
#
do_test 1.0 {
  db close
  sqlite3 db test.db
  set ::log [list]
  set n [llength [execsql {CALL pwc()}]]
  list $n [lindex $::log 0]
} {6 SQLITE_WARNING}

# The message says WHY, not WHAT.  "add an index" is nagging; naming the
# correlation that costs the sort is actionable.
#
# Checked on the SAME call as 1.0 rather than a second one.  An earlier draft
# called CALL again and required another log line; that is stricter than the
# design.  R7's purpose is to catch an index DROPPED AFTER DEPLOYMENT, which
# changes the schema, expires statements and forces a recompile -- so advising
# at compile is sufficient, and the procedure cache legitimately serves a
# repeated identical call without recompiling.  2.0/2.1 still cover the case
# that matters, because creating and dropping an index recompiles.
do_test 1.1 {
  db close
  sqlite3 db test.db
  set ::log [list]
  execsql {CALL pwc()}
  set hit 0
  foreach {code msg} $::log {
    if {[string match {*comments*post_id*} $msg]} { set hit 1 }
  }
  list $hit [lindex $::log 0]
} {1 SQLITE_WARNING}

#--------------------------------------------------------------------
# 2.x: THE OTHER DIRECTION.  With an index the advisory must VANISH.
#
# Without this the feature could be a function that always logs, which is not
# a detector.
#
do_test 2.0 {
  execsql { CREATE INDEX cpost ON comments(post_id) }
  set ::log [list]
  set n [llength [execsql {CALL pwc()}]]
  list $n [llength $::log]
} {6 0}

# And back again -- dropping the index restores it.
# Matches the MESSAGE, not merely a non-empty log.  An earlier draft of this
# case checked "log is not empty" and passed before the feature existed,
# because DROP INDEX makes the next statement log SQLITE_SCHEMA.  A test that
# can be satisfied by an unrelated log entry is not testing this feature.
do_test 2.1 {
  execsql { DROP INDEX cpost }
  set ::log [list]
  execsql {CALL pwc()}
  set hit 0
  foreach {code msg} $::log {
    if {[string match {*comments*post_id*} $msg]} { set hit 1 }
  }
  set hit
} {1}

#--------------------------------------------------------------------
# 3.x: never an error, and never for a procedure that does not nest
#
do_test 3.0 {
  execsql {
    CREATE PROCEDURE flat() RETURNS TABLE(id INTEGER)
    BEGIN SELECT id FROM posts; END;
  }
  set ::log [list]
  set n [llength [execsql {CALL flat()}]]
  list $n [llength $::log]
} {2 0}

# A projected-away nested table still streams its segment, so the ordering is
# still imposed and the advisory still applies.
do_test 3.1 {
  set ::log [list]
  execsql {CALL pwc() RETURNING id, title}
  set hit 0
  foreach {code msg} $::log {
    if {[string match {*comments*post_id*} $msg]} { set hit 1 }
  }
  set hit
} {1}

#--------------------------------------------------------------------
# 4.x: DOCKET 3g -- a hand-rolled inner nesting level is advised, not refused
#
# Depth >= 2 is refused at the grammar, but an author reaches it anyway by
# writing the inner level with json_group_array themselves.  That works, and
# silently forfeits the correlation check, the imposed ordering, conformance and
# WITH COUNTS.  The engine cannot stop it and should not -- the construct is
# legitimate -- but the author is entitled to know which side of the guarantee
# they are on.
#
do_execsql_test 4.0 {
  CREATE TABLE addr(aid INTEGER PRIMARY KEY, cid INTEGER, tradition TEXT);
  INSERT INTO addr VALUES(1,1,'LXX'),(2,1,'MT'),(3,2,'Byz');
  CREATE PROCEDURE handrolled()
    RETURNS TABLE(id INTEGER,
                  kids TABLE(post_id INTEGER, cid INTEGER, addrs TEXT)
                    KEY(post_id = id))
  BEGIN
    SELECT id FROM posts;
    SELECT c.post_id, c.cid,
           (SELECT json_group_array(json_object('t', a.tradition))
              FROM addr a WHERE a.cid = c.cid)
      FROM comments c;
  END;
} {}

do_test 4.1 {
  db close
  sqlite3 db test.db
  set ::log [list]
  execsql {CALL handrolled()}
  set hit 0
  foreach {code msg} $::log {
    if {[string match {*handrolled*kids*by hand*} $msg]} { set hit 1 }
  }
  set hit
} {1}

# CONTROL: a procedure that does NOT nest by hand must not draw the advisory,
# or it is a function that always logs rather than a detector.
do_test 4.2 {
  db close
  sqlite3 db test.db
  set ::log [list]
  execsql {CALL pwc()}
  set hit 0
  foreach {code msg} $::log {
    if {[string match {*by hand*} $msg]} { set hit 1 }
  }
  set hit
} {0}

# And it is ADVISORY: the call still returns its rows.
do_test 4.3 {
  llength [execsql {CALL handrolled()}]
} {4}   ;# 2 parents x 2 columns

db close
sqlite3_shutdown
test_sqlite3_log
sqlite3_initialize
sqlite3 db test.db

finish_test
