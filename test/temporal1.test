#
# PLAN-TEMPORAL Q0 -- system-versioned tables.  THIS FILE IS WRITTEN
# RED, ON PURPOSE, BEFORE THE FEATURE EXISTS: on first run the grammar
# has never heard of TEMPORAL and every section dies at parse.
#
# Do not adjust an expectation here to make the suite pass.  If an
# expectation is wrong, PLAN-TEMPORAL.md changes first, with the
# reason.  The rulings these pins encode are DESIGN-TEMPORAL's eight,
# Sean, 2026-08-15.

set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix temporal1

# --- DDL and the shadow ---
# The shadow declares PRIMARY KEY(a, seq_from) -- its natural version
# key, required so history travels in session changesets (PLAN-REPL) --
# hence the autoindex beside it.
do_execsql_test 1.0 {
  CREATE TEMPORAL TABLE t(a INTEGER PRIMARY KEY, b TEXT)
    WITH SYSTEM VERSIONING;
  SELECT name FROM sqlite_schema WHERE name LIKE '%t%' ORDER BY name;
} {sqlite_autoindex_sqlite_hist_t_1 sqlite_hist_commits sqlite_hist_meta
   sqlite_hist_t t}

# --- one commit, one seq; the shadow carries final images ---
do_execsql_test 1.1 {
  BEGIN;
    INSERT INTO t VALUES(1,'one');
    INSERT INTO t VALUES(2,'two');
  COMMIT;
  SELECT a, b FROM t ORDER BY a;
} {1 one 2 two}
do_execsql_test 1.2 {
  SELECT a, b, seq_from, seq_to FROM sqlite_hist_t ORDER BY a;
} {1 one 1 {} 2 two 1 {}}
do_execsql_test 1.3 {
  SELECT count(*) FROM sqlite_hist_commits;
} {1}

# --- POC 1 disease 1, pinned absent: intra-transaction intermediate
# states never enter history.  Two updates of one row in one
# transaction leave exactly ONE new history row, carrying the FINAL
# value, and the seq advanced by exactly one. ---
do_execsql_test 2.0 {
  BEGIN;
    UPDATE t SET b='mid'   WHERE a=1;
    UPDATE t SET b='final' WHERE a=1;
  COMMIT;
  SELECT count(*) FROM sqlite_hist_t WHERE a=1;
} {2}
do_execsql_test 2.1 {
  SELECT b FROM sqlite_hist_t WHERE a=1 AND seq_to IS NULL;
} {final}
do_execsql_test 2.2 {
  SELECT count(*) FROM sqlite_hist_t WHERE a=1 AND b='mid';
} {0}
do_execsql_test 2.3 {
  SELECT max(seq) FROM sqlite_hist_commits;
} {2}

# --- seqs advance per COMMIT, not per statement ---
do_execsql_test 2.4 {
  UPDATE t SET b='three' WHERE a=2;
  DELETE FROM t WHERE a=2;
  SELECT max(seq) FROM sqlite_hist_commits;
} {4}

# --- AS OF across the whole lifecycle ---
do_execsql_test 3.0 {
  SELECT b FROM t FOR SYSTEM_TIME AS OF 1 WHERE a=1;
} {one}
do_execsql_test 3.1 {
  SELECT b FROM t FOR SYSTEM_TIME AS OF 2 WHERE a=1;
} {final}
do_execsql_test 3.2 {
  SELECT a, b FROM t FOR SYSTEM_TIME AS OF 3 ORDER BY a;
} {1 final 2 three}
do_execsql_test 3.3 {
  SELECT a FROM t FOR SYSTEM_TIME AS OF 4 ORDER BY a;
} {1}
do_execsql_test 3.4 {
  SELECT count(*) FROM t FOR SYSTEM_TIME AS OF 0;
} {0}

# --- AS OF by UTC text resolves through the commit log; pinned via
# the log's own values so no wall-clock guessing enters the suite ---
do_execsql_test 4.0 {
  SELECT b FROM t FOR SYSTEM_TIME AS OF
    (SELECT utc FROM sqlite_hist_commits WHERE seq=2) WHERE a=1;
} {final}
do_execsql_test 4.1 {
  SELECT count(*) FROM sqlite_hist_commits WHERE utc NOT LIKE '____-__-__ __:__:__._%';
} {0}

# --- the truth surface ---
do_execsql_test 5.0 {
  SELECT name, watermark, nhist FROM pragma_history_list;
} {t 0 4}

# --- reopen: temporal-ness is schema, not session state ---
db close
sqlite3 db test.db
do_execsql_test 5.1 {
  SELECT b FROM t FOR SYSTEM_TIME AS OF 1 WHERE a=1;
} {one}

# --- DROP discipline ---
do_catchsql_test 6.0 {
  DROP TABLE t;
} {1 {t is system-versioned; use DROP TEMPORAL TABLE to drop it together with its history}}
do_execsql_test 6.1 {
  CREATE TEMPORAL TABLE scratch(x INTEGER PRIMARY KEY)
    WITH SYSTEM VERSIONING;
  DROP TEMPORAL TABLE scratch;
  SELECT count(*) FROM sqlite_schema WHERE name LIKE '%scratch%';
} {0}

# --- ALTER: ADD COLUMN honest-NULL; shape changes refuse ---
do_execsql_test 7.0 {
  ALTER TABLE t ADD COLUMN c INTEGER;
  UPDATE t SET c=9 WHERE a=1;
  SELECT c FROM t FOR SYSTEM_TIME AS OF 1 WHERE a=1;
} {{}}
do_execsql_test 7.1 {
  SELECT c FROM t FOR SYSTEM_TIME AS OF 6 WHERE a=1;
} {9}
do_catchsql_test 7.2 {
  ALTER TABLE t RENAME COLUMN b TO bb;
} {1 {t is system-versioned; its history carries the current shape (only ADD COLUMN is supported)}}
do_catchsql_test 7.3 {
  ALTER TABLE t DROP COLUMN c;
} {1 {t is system-versioned; its history carries the current shape (only ADD COLUMN is supported)}}

# --- prune: explicit, watermarked, and REFUSING rather than
# fabricating on the far side ---
# (Surface correction, recorded in PLAN-TEMPORAL: a pragma table-
# function binds its second argument as the SCHEMA name, so prune is a
# DIRECTONLY function instead -- it writes, and the wall against views
# and triggers is exactly right for it.)
do_execsql_test 8.0 {
  SELECT sqlite_history_prune('t', 2);
} {1}
do_execsql_test 8.1 {
  SELECT watermark FROM pragma_history_list WHERE name='t';
} {2}
do_catchsql_test 8.2 {
  SELECT b FROM t FOR SYSTEM_TIME AS OF 1 WHERE a=1;
} {1 {history of t is pruned before seq 2; the answer would be fabricated}}
do_execsql_test 8.3 {
  SELECT b FROM t FOR SYSTEM_TIME AS OF 2 WHERE a=1;
} {final}

# --- interactions declared in DESIGN-TEMPORAL Q7, superseded by
# --- DESIGN-IVM-TEMPORAL Q1 (ruled 2026-08-16): the composition is
# --- ACCEPTED now; ivmt1 section 1 carries the full pins.
do_execsql_test 9.0 {
  CREATE MATERIALIZED VIEW mv AS SELECT count(*) AS n FROM t;
  SELECT n FROM mv;
} {1}

# --- the shadow is protected like the machinery it is ---
do_catchsql_test 9.1 {
  DELETE FROM sqlite_hist_t;
} {1 {table sqlite_hist_t may not be modified}}

# --- healthy-file inertness: plain tables see nothing ---
do_execsql_test 10.0 {
  CREATE TABLE plain(x INTEGER);
  INSERT INTO plain VALUES(1);
  SELECT count(*) FROM pragma_history_list WHERE name='plain';
} {0}

# --- system versioning keys history by PRIMARY KEY (2026-08-16) ---
reset_db

# A PK-less temporal table is REFUSED with the fix named: its capture
# could only key on rowid, and shadow rowids drift from base rowids
# after the first UPDATE -- history then closes the wrong versions
# (measured: two open intervals for one key, AS OF returning a state
# no reader ever saw).
do_catchsql_test 11.0 {
  CREATE TEMPORAL TABLE nopk(a INTEGER, b TEXT) WITH SYSTEM VERSIONING;
} {1 {TEMPORAL table nopk has no PRIMARY KEY; system versioning keys history by the PRIMARY KEY -- declare one}}
do_execsql_test 11.1 {
  SELECT count(*) FROM sqlite_schema WHERE name LIKE '%nopk%';
} {0}

# A rowid table with a declared non-INTEGER PK keys on that PK (this
# case silently keyed on rowid coincidence before the fix).  The
# divergence recipe: UPDATE makes shadow rowids outrun base rowids,
# then a later row's UPDATE must still close ITS OWN prior version.
do_execsql_test 11.2 {
  CREATE TEMPORAL TABLE tpk(k TEXT PRIMARY KEY, v INTEGER)
    WITH SYSTEM VERSIONING;
  INSERT INTO tpk VALUES('a', 1);
  UPDATE tpk SET v=2 WHERE k='a';
  INSERT INTO tpk VALUES('b', 10);
  UPDATE tpk SET v=11 WHERE k='b';
  SELECT k, v, seq_from, coalesce(seq_to,'open')
    FROM sqlite_hist_tpk ORDER BY k, seq_from;
} {a 1 1 2 a 2 2 open b 10 3 4 b 11 4 open}
do_execsql_test 11.3 {
  SELECT k, v FROM tpk FOR SYSTEM_TIME AS OF 3 ORDER BY k;
} {a 2 b 10}

# --- REPLACE displacement reaches capture (2026-08-16) ---
# A REPLACE-displaced row is a real deletion.  Upstream gates the
# displaced row's DELETE triggers on PRAGMA recursive_triggers; the
# engine's own capture is exempt (insert.c/trigger.c), while USER
# delete triggers stay gated exactly as upstream.  Found by POC-T3's
# sharp edge: before the fix, a UNIQUE-displaced row left a GHOST open
# interval and AS OF returned a state that never existed (two rows
# sharing a UNIQUE value).
reset_db
do_execsql_test 12.0 {
  PRAGMA recursive_triggers=OFF;
  CREATE TEMPORAL TABLE r(id INTEGER PRIMARY KEY, u TEXT UNIQUE, v TEXT)
    WITH SYSTEM VERSIONING;
  CREATE TABLE audit(msg TEXT);
  CREATE TRIGGER r_userdel AFTER DELETE ON r BEGIN
    INSERT INTO audit VALUES(OLD.id);
  END;
  INSERT INTO r VALUES(1, 'alpha', 'first');
  REPLACE INTO r VALUES(2, 'alpha', 'second');
  SELECT id, v, seq_from, coalesce(seq_to,'open')
    FROM sqlite_hist_r ORDER BY seq_from, id;
} {1 first 1 2 2 second 2 open}
do_execsql_test 12.1 {
  SELECT id, u FROM r FOR SYSTEM_TIME AS OF 2 ORDER BY id;
} {2 alpha}
do_execsql_test 12.2 {
  SELECT count(*) FROM audit;
} {0}
do_execsql_test 12.3 {
  PRAGMA recursive_triggers=ON;
  INSERT INTO r VALUES(3, 'beta', 'x');
  REPLACE INTO r VALUES(4, 'beta', 'y');
  SELECT (SELECT count(*) FROM audit),
         (SELECT count(*) FROM sqlite_hist_r
           WHERE id=3 AND seq_to IS NOT NULL);
} {1 1}
# Same-PK REPLACE: the INSERT capture closes by key; still exact.
do_execsql_test 12.4 {
  PRAGMA recursive_triggers=OFF;
  REPLACE INTO r VALUES(4, 'beta', 'y2');
  SELECT count(*) FROM sqlite_hist_r WHERE id=4 AND seq_to IS NULL;
} {1}

finish_test
